    <div class="container footer-top"><a class="brand" href="#inicio"><img src="/assets/logo.svg" alt="Family Game Festival" /></a><p>Games, cultura geek e impacto local.<br />Bauru · 19—20 setembro 2026</p><a class="button button-yellow button-small" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar ingresso <span aria-hidden="true">↗</span></a></div>
    <div class="container footer-bottom"><span>© 2026 Family Game Festival</span><a href={event.instagramUrl} target="_blank" rel="noreferrer">{event.instagram}</a><span>Parte da arrecadação será revertida para a SORRI Bauru.</span><span class="footer-credit">Desenvolvido pela <a href="https://www.instagram.com/usealterstate/" target="_blank" rel="noreferrer">ALTERSTATE</a></span></div>
  </footer>

  <script>
    const homeDayTabs = document.querySelectorAll<HTMLButtonElement>('[data-home-day-tab]');
    const homeDayPanels = document.querySelectorAll<HTMLElement>('[data-home-day-panel]');

    const activateHomeDay = (slug: string) => {
      homeDayTabs.forEach((tab) => {
        const active = tab.getAttribute('data-home-day-tab') === slug;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      homeDayPanels.forEach((panel) => {
        const active = panel.getAttribute('data-home-day-panel') === slug;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    };

    homeDayTabs.forEach((tab) => tab.addEventListener('click', () => {
      const slug = tab.getAttribute('data-home-day-tab');
      if (slug) activateHomeDay(slug);
    }));

    document.querySelectorAll<HTMLElement>('[data-home-competition-item]').forEach((item) => {
      const toggle = item.querySelector<HTMLButtonElement>('[data-home-competition-toggle]');
      const details = item.querySelector<HTMLElement>('[data-home-competition-details]');
      if (!toggle || !details) return;

      toggle.addEventListener('click', () => {
        const expanded = item.classList.toggle('is-expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        details.hidden = !expanded;
      });
    });

    document.querySelectorAll('[data-ticket-carousel]').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-ticket-track]');
      const cards = Array.from(carousel.querySelectorAll<HTMLElement>('[data-ticket-card]'));
      const previous = carousel.querySelector<HTMLButtonElement>('[data-ticket-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-ticket-next]');
      const status = carousel.querySelector<HTMLElement>('[data-ticket-status]');
      if (!track || !cards.length || !previous || !next || !status) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let autoplayTimer: number | undefined;
      let isPaused = false;

      const getStep = () => {
        const card = cards[0];
        if (!card) return 0;
        const styles = window.getComputedStyle(track);
        const gap = Number.parseFloat(styles.columnGap || styles.gap || '0');
        return card.getBoundingClientRect().width + gap;
      };

      const getVisible = (step: number) => step ? Math.max(1, Math.round(track.clientWidth / step)) : 1;
      const getMaxStart = (step: number) => Math.max(0, cards.length - getVisible(step));
      const getCurrent = (step: number) => {
        const maxStart = getMaxStart(step);
        return step ? Math.min(maxStart, Math.max(0, Math.round(track.scrollLeft / step))) : 0;
      };

      const updateCarousel = () => {
        const step = getStep();
        const visible = getVisible(step);
        const current = getCurrent(step);
        const first = Math.min(cards.length, current + 1);
        const last = Math.min(cards.length, first + visible - 1);
        const hasOverflow = getMaxStart(step) > 0;
        status.textContent = `${first}–${last} de ${cards.length}`;
        previous.disabled = !hasOverflow;
        next.disabled = !hasOverflow;
      };

      const scrollToIndex = (index: number) => {
        const step = getStep();
        if (!step) return;
        track.scrollTo({ left: Math.max(0, index) * step, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      };

      const move = (direction: number) => {
        const step = getStep();
        const maxStart = getMaxStart(step);
        if (!maxStart) return;
        const current = getCurrent(step);
        const target = direction > 0
          ? current >= maxStart ? 0 : current + 1
          : current <= 0 ? maxStart : current - 1;
        scrollToIndex(target);
      };

      const stopAutoplay = () => {
        if (autoplayTimer) window.clearInterval(autoplayTimer);
        autoplayTimer = undefined;
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (isPaused || reduceMotion.matches || document.hidden || cards.length < 2) return;
        autoplayTimer = window.setInterval(() => move(1), 4800);
      };

      const pauseAutoplay = () => {
        isPaused = true;
        stopAutoplay();
      };

      const resumeAutoplay = () => {
        isPaused = false;
        startAutoplay();
      };

      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      carousel.addEventListener('mouseenter', pauseAutoplay);
      carousel.addEventListener('mouseleave', resumeAutoplay);
      carousel.addEventListener('focusin', pauseAutoplay);
      carousel.addEventListener('focusout', (event) => {
        const focusEvent = event as FocusEvent;
        if (!(focusEvent.relatedTarget instanceof Node) || !carousel.contains(focusEvent.relatedTarget)) resumeAutoplay();
      });
      track.addEventListener('scroll', updateCarousel, { passive: true });
      track.addEventListener('touchstart', pauseAutoplay, { passive: true });
      window.addEventListener('resize', () => {
        updateCarousel();
        if (!isPaused) startAutoplay();
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });
      updateCarousel();
      startAutoplay();
    });

    const countdown = document.querySelector('[data-countdown]');
    const countdownTarget = countdown?.getAttribute('data-countdown-target');
    const countdownStatus = countdown?.querySelector('[data-countdown-status]');
    const countdownDays = countdown?.querySelector('[data-countdown-days]');
    const countdownHours = countdown?.querySelector('[data-countdown-hours]');
    const countdownMinutes = countdown?.querySelector('[data-countdown-minutes]');
    const countdownSeconds = countdown?.querySelector('[data-countdown-seconds]');

    if (countdown && countdownTarget && countdownDays && countdownHours && countdownMinutes && countdownSeconds) {
      const targetTimestamp = new Date(countdownTarget).getTime();

      const updateCountdown = () => {
        const remaining = Math.max(targetTimestamp - Date.now(), 0);
        const totalSeconds = Math.floor(remaining / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        const format = (value: number) => String(value).padStart(2, '0');

        countdownDays.textContent = format(days);
        countdownHours.textContent = format(hours);
        countdownMinutes.textContent = format(minutes);
        countdownSeconds.textContent = format(seconds);

        if (remaining === 0 && countdownStatus) countdownStatus.textContent = 'O FESTIVAL COMEÇOU';
      };

      updateCountdown();
      const countdownTimer = window.setInterval(updateCountdown, 1000);
      window.addEventListener('pagehide', () => window.clearInterval(countdownTimer), { once: true });
    }
  </script>
</BaseLayout>
