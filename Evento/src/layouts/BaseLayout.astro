---
import '../styles/global.css';
import { event } from '../data/event';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = event.name,
  description = 'Games, cultura geek, campeonatos e experiências para toda a família em Bauru.',
} = Astro.props;

const canonical = 'https://familygamefestival.vercel.app/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Festival',
  name: event.name,
  description,
  startDate: '2026-09-19T10:00:00-03:00',
  endDate: '2026-09-20T20:00:00-03:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Av. Nações Unidas, 53-40',
      addressLocality: 'Bauru',
      addressRegion: 'SP',
      addressCountry: 'BR'
    }
  },
  organizer: { '@type': 'Organization', name: 'Family Game Festival' },
  offers: { '@type': 'Offer', url: event.ticketUrl, price: '30', priceCurrency: 'BRL', availability: 'https://schema.org/InStock' }
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08111f" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
