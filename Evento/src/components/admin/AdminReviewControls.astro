---
import { ADMIN_REVIEW_STATUSES, adminReviewStatusLabel, type AdminReviewStatus } from '../../lib/server/admin/data';

interface Props {
  registrationId: string;
  status: AdminReviewStatus;
  returnTo: string;
}

const { registrationId, status, returnTo } = Astro.props;
---

<section class="admin-v2-card admin-review-card" aria-labelledby="review-status-title">
  <div class="admin-v2-card-heading">
    <div>
      <p class="admin-section-kicker">Conferência manual</p>
      <h2 id="review-status-title">Status da ficha</h2>
      <p>A abertura e o download dos arquivos não alteram este status.</p>
    </div>
    <span class:list={['admin-v2-status', 'status-' + status]}>{adminReviewStatusLabel(status)}</span>
  </div>
  <div class="admin-review-actions">
    {ADMIN_REVIEW_STATUSES.map((nextStatus) => (
      <form method="post" action={'/api/admin/inscricoes/' + registrationId + '/review'}>
        <input type="hidden" name="status" value={nextStatus} />
        <input type="hidden" name="returnTo" value={returnTo} />
        <button class:list={['admin-button', nextStatus === status ? 'admin-button-primary' : 'admin-button-secondary']} type="submit" aria-current={nextStatus === status ? 'true' : undefined}>
          {adminReviewStatusLabel(nextStatus)}
        </button>
      </form>
    ))}
  </div>
</section>
