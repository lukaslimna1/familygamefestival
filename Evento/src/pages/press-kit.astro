---
import BaseLayout from '../layouts/BaseLayout.astro';
import { event, navItems, guests, pressKitAngles, pressKitSnippets } from '../data/event';

const navLinks = navItems.map((item) => ({ ...item, href: item.href.startsWith('#') ? `/${item.href}` : item.href }));

const pressMaterials = [
  { number: '01', title: 'Release oficial', text: 'Texto-base para adaptar a portais, jornais, blogs e agendas culturais.', accent: 'yellow' },
  { number: '02', title: 'Serviço completo', text: 'Data, horário, local, endereço, atrações e programação competitiva.', accent: 'cyan' },
  { number: '03', title: 'Identidade do evento', text: 'Logo, mascotes em SVG e informações oficiais para peças e chamadas.', accent: 'pink' },
  { number: '04', title: 'Orientação de cobertura', text: 'Pautas, fontes para entrevista e caminhos para imagens e vídeos.', accent: 'red' }
] as const;

const programHighlights = [
  { title: 'Campeonatos', text: 'Cosplay, Just Dance, Fight Games, FC 26, eFootball e Top Gear 1.' },
  { title: 'Experiências', text: 'Free Play atual e retrô, K-pop, Random Play Dance e expositores.' },
  { title: 'Atrações', text: 'Raul Schlosser, Lana VGS e uma programação feita para toda a família.' }
] as const;
---

<BaseLayout
  title="Press Kit | Family Game Festival"
  description="Informações oficiais, releases e materiais de divulgação do Family Game Festival 2026."
  canonical="https://familygamefestival.vercel.app/press-kit"
>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="Family Game Festival · início">
        <img src="/assets/logo.svg" alt="Family Game Festival" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span>
        <span class="sr-only">Abrir menu</span>
      </button>
      <nav class="main-nav" id="main-nav" aria-label="Navegação principal">
        {navLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button button-small button-yellow nav-cta" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar ingresso <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>

  <main>
    <section class="sponsor-page-hero press-kit-hero">
      <div class="container sponsor-page-hero-grid">
        <div class="sponsor-page-hero-copy">
          <p class="eyebrow eyebrow-cyan">Press Kit oficial · mídia & divulgação</p>
          <h1>Bauru <em>entra no jogo.</em></h1>
          <p>Informações oficiais, serviço, pautas e textos prontos para portais, jornais, rádio, TV, podcasts e mídias parceiras.</p>
          <div class="sponsor-page-actions">
            <a class="button button-yellow" href={event.whatsapp.sponsors} target="_blank" rel="noreferrer">Falar com a organização <span aria-hidden="true">↗</span></a>
            <a class="button button-outline-light" href="/">Voltar ao festival <span aria-hidden="true">↩</span></a>
          </div>
        </div>
        <div class="sponsor-hero-index press-kit-index" aria-hidden="true">
          <span class="sponsor-hero-index-small">FGF / 26 · MEDIA</span>
          <strong>PRESS<br /><em>KIT</em></strong>
          <span class="sponsor-hero-index-line"></span>
          <span class="sponsor-hero-index-foot">PAUTA → SERVIÇO → COBERTURA</span>
        </div>
      </div>
    </section>

    <section class="section section-light press-kit-overview">
      <div class="container press-kit-intro-grid">
        <div class="press-kit-overview-copy">
          <p class="eyebrow eyebrow-red">O evento em 30 segundos</p>
          <h2>Um festival de games e cultura geek para toda a família.</h2>
          <p>Nos dias 19 e 20 de setembro de 2026, Bauru recebe uma arena de jogos atuais e retrô, campeonatos, cosplay, Just Dance, K-pop, Random Play Dance, Free Play, atrações especiais e produtos.</p>
          <p>O Family Game Festival acontece na Arena Tauste, dentro da SORRI Bauru, com programação das 11h às 21h.</p>
        </div>
        <div class="press-kit-fact-board">
          <p class="eyebrow eyebrow-yellow">Serviço oficial</p>
          <div class="press-kit-facts" aria-label="Serviço oficial do evento">
            <div class="press-kit-fact"><span>QUANDO</span><strong>19 e 20</strong><small>SETEMBRO DE 2026</small></div>
            <div class="press-kit-fact"><span>HORÁRIO</span><strong>{event.hours}</strong><small>ABERTURA AO PÚBLICO</small></div>
            <div class="press-kit-fact"><span>ONDE</span><strong>SORRI</strong><small>BAURU · ARENA TAUSTE</small></div>
          </div>
          <p class="press-kit-address">{event.address}</p>
        </div>
      </div>
    </section>

    <section class="section section-dark press-kit-section">
      <div class="container">
        <div class="section-heading heading-row press-kit-heading">
          <div><p class="eyebrow eyebrow-yellow">Por que é pauta</p><h2>Histórias que cabem em vários formatos.</h2></div>
          <p class="heading-note heading-note-light">Escolha o recorte editorial e fale com a organização para receber apoio na apuração.</p>
        </div>
        <div class="press-kit-angle-grid">
          {pressKitAngles.map((angle, index) => (
            <article class={`press-kit-angle-card press-kit-accent-${angle.accent}`}>
              <span>0{index + 1}</span>
              <h3>{angle.title}</h3>
              <p>{angle.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-light press-kit-section">
      <div class="container press-kit-program-layout">
        <div>
          <p class="eyebrow eyebrow-cyan">O que vai acontecer</p>
          <h2>Do palco à área de Free Play.</h2>
          <div class="press-kit-program-list">
            {programHighlights.map((item, index) => (
              <article class="press-kit-program-item">
                <span>0{index + 1}</span>
                <div><h3>{item.title}</h3><p>{item.text}</p></div>
              </article>
            ))}
          </div>
        </div>
        <div>
          <p class="eyebrow eyebrow-pink">Fontes para entrevista</p>
          <div class="press-kit-source-grid">
            {guests.map((guest) => (
              <article class={`press-source-card press-source-${guest.accent}`}>
                <div class="press-source-art"><img src={guest.image} alt={`${guest.name} no Family Game Festival`} loading="lazy" /></div>
                <div class="press-source-copy"><p class="card-eyebrow">{guest.role}</p><h3>{guest.name}</h3><p>{guest.description}</p><a class="text-link" href={guest.instagramUrl} target="_blank" rel="noreferrer">{guest.handle} <span aria-hidden="true">↗</span></a></div>
              </article>
            ))}
          </div>
          <p class="press-kit-source-note">A organização também pode indicar competidores, cosplayers e participantes para entrevistas e depoimentos.</p>
        </div>
      </div>
    </section>

    <section class="section section-dark press-kit-material-section">
      <div class="container press-kit-material-grid">
        <div class="press-kit-material-copy">
          <p class="eyebrow eyebrow-yellow">Material oficial</p>
          <h2>Pronto para virar chamada, matéria ou vídeo.</h2>
          <p>Use os materiais como base, adapte para o seu formato e mantenha as informações de serviço do evento. Se precisar de imagens, logos ou orientação, fale com a organização.</p>
        </div>
        <div class="press-kit-material-list">
          {pressMaterials.map((material) => (
            <article class={`press-kit-material press-kit-accent-${material.accent}`}>
              <span>{material.number}</span><h3>{material.title}</h3><p>{material.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-light press-kit-section">
      <div class="container">
        <div class="section-heading heading-row press-kit-heading">
          <div><p class="eyebrow eyebrow-red">Textos prontos para publicar</p><h2>Escolha o formato e ajuste à sua voz.</h2></div>
          <p class="heading-note">Chamadas curtas para rádio, TV, portais, jornais, podcasts e agendas.</p>
        </div>
        <div class="press-kit-snippet-grid">
          {pressKitSnippets.map((snippet) => (
            <article class={`press-kit-snippet press-kit-accent-${snippet.accent}`}>
              <p class="press-kit-snippet-label">{snippet.label}</p>
              <p>{snippet.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section press-kit-contact-section">
      <div class="container press-kit-contact-grid">
        <div><p class="eyebrow eyebrow-yellow">Contato de imprensa</p><h2>Vamos colocar essa pauta em jogo?</h2><p>Para release, imagens, entrevistas, logos, mascotes e informações complementares, fale diretamente com a organização.</p><div class="press-kit-contact-actions"><a class="button button-yellow" href={event.whatsapp.sponsors} target="_blank" rel="noreferrer">Falar com o Juruna <span aria-hidden="true">↗</span></a><a class="button button-outline-light" href="/">Voltar ao site <span aria-hidden="true">↩</span></a></div></div>
        <div class="press-kit-contact-card"><span>CANAL OFICIAL</span><strong>+55 14<br />99115-2263</strong><a href={event.instagramUrl} target="_blank" rel="noreferrer">{event.instagram} <span aria-hidden="true">↗</span></a><small>familygamefestival.vercel.app</small></div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-top"><a class="brand" href="/"><img src="/assets/logo.svg" alt="Family Game Festival" /></a><p>Games, cultura geek e impacto local.<br />Bauru · 19—20 setembro 2026</p><a class="button button-yellow button-small" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar ingresso <span aria-hidden="true">↗</span></a></div>
    <div class="container footer-bottom"><span>© 2026 Family Game Festival</span><a href="/">Voltar ao festival</a><span>Parte da arrecadação será revertida para a SORRI Bauru.</span></div>
  </footer>

  <script>
    const header = document.querySelector('.site-header');
    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelectorAll('.main-nav a');
    menuToggle?.addEventListener('click', () => {
      const open = header?.classList.toggle('menu-open') ?? false;
      menuToggle.setAttribute('aria-expanded', String(open));
    });
    navLinks.forEach((link) => link.addEventListener('click', () => {
      header?.classList.remove('menu-open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }));
  </script>
</BaseLayout>
