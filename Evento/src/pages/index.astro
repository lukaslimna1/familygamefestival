  <!-- Script Frontend de Interação do Formulário -->
  <script>
    // Gerenciador de Seleção dos 3 Cards de Tipo
    const typeButtons = document.querySelectorAll<HTMLButtonElement>('[data-type-btn]');
    const formContainer = document.getElementById('feedback-form-container');
    const inputTipo = document.getElementById('input-tipo') as HTMLInputElement | null;
    const formSelectedPill = document.getElementById('form-selected-pill');
    const formSelectedDesc = document.getElementById('form-selected-desc');

    const typeDescriptions: Record<string, { label: string; desc: string }> = {
      sugestao: {
        label: 'SUGESTÃO',
        desc: 'Conte sua ideia para tornar as próximas edições e experiências ainda melhores.'
      },
      elogio: {
        label: 'ELOGIO',
        desc: 'Fale sobre o que você mais curtiu no evento! Ficamos felizes em saber o que deu certo.'
      },
      reclamacao: {
        label: 'RECLAMAÇÃO',
        desc: 'Relate com detalhes o que não funcionou. Toda crítica é analisada para correções imediatas.'
      }
    };

    const selectType = (type: string) => {
      typeButtons.forEach((btn) => {
        const isMatch = btn.getAttribute('data-type-btn') === type;
        btn.classList.toggle('is-selected', isMatch);
        btn.setAttribute('aria-pressed', String(isMatch));
      });

      if (inputTipo) inputTipo.value = type;

      const info = typeDescriptions[type] || typeDescriptions.sugestao;
      if (formSelectedPill) formSelectedPill.textContent = info.label;
      if (formSelectedDesc) formSelectedDesc.textContent = info.desc;

      if (formContainer) {
        formContainer.hidden = false;
        // Scroll suave até o formulário
        formContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    typeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-type-btn');
        if (type) selectType(type);
      });
    });

    // Estrelas Interativas
    const starInputs = document.querySelectorAll<HTMLInputElement>('input[name="estrelas"]');
    const starLabels = document.querySelectorAll<HTMLLabelElement>('.star-label');
    const starCaption = document.getElementById('star-caption');

    const captions: Record<number, string> = {
      1: '1 estrela — Muito ruim',
      2: '2 estrelas — Precisa melhorar',
      3: '3 estrelas — Regular / Bom',
      4: '4 estrelas — Muito bom!',
      5: '5 estrelas — Excelente! Adorei!'
    };

    const updateStarDisplay = (value: number) => {
      starLabels.forEach((label, idx) => {
        label.classList.toggle('is-lit', idx < value);
      });
      if (starCaption) {
        starCaption.textContent = captions[value] || 'Selecione uma nota';
      }
    };

    starInputs.forEach((input) => {
      input.addEventListener('change', () => {
        const val = Number(input.value);
        updateStarDisplay(val);
      });
    });

    // Contador de Caracteres da Mensagem
    const messageTextarea = document.getElementById('mensagem-textarea') as HTMLTextAreaElement | null;
    const charCounter = document.getElementById('char-counter');
    messageTextarea?.addEventListener('input', () => {
      if (charCounter && messageTextarea) {
        const len = messageTextarea.value.length;
        charCounter.textContent = `${len} / 2000`;
        charCounter.style.color = len > 1900 ? 'var(--yellow)' : 'rgba(255, 255, 255, .5)';
      }
    });

    // Alternância de Identificação (Anônimo vs Identificado)
    const anonimoRadios = document.querySelectorAll<HTMLInputElement>('input[name="anonimo"]');
    const identifiedFields = document.getElementById('identified-fields');
    const contactBox = document.getElementById('contact-permission-box');
    const nomeInput = document.getElementById('nome-input') as HTMLInputElement | null;
    const emailInput = document.getElementById('email-input') as HTMLInputElement | null;

    const toggleIdentification = (isAnonimo: boolean) => {
      if (identifiedFields) {
        identifiedFields.style.display = isAnonimo ? 'none' : 'block';
      }
      if (contactBox) {
        contactBox.style.display = isAnonimo ? 'none' : 'block';
      }
      if (nomeInput) nomeInput.required = !isAnonimo;
      if (emailInput) emailInput.required = !isAnonimo;

      const pubOptionName = document.getElementById('pub-option-name');
      const pubNameRadio = document.querySelector<HTMLInputElement>('input[name="autorizacaoPublicacao"][value="nome"]');
      const pubAnonRadio = document.querySelector<HTMLInputElement>('input[name="autorizacaoPublicacao"][value="anonimo"]');

      if (pubOptionName) {
        pubOptionName.style.display = isAnonimo ? 'none' : 'flex';
      }
      if (isAnonimo && pubNameRadio?.checked && pubAnonRadio) {
        pubAnonRadio.checked = true;
      }
    };

    anonimoRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        toggleIdentification(radio.value === 'true');
      });
    });

    // Envio do Formulário com Validação e Feedback Instantâneo
    const feedbackForm = document.getElementById('feedback-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const errorBox = document.getElementById('form-error-box');
    const successState = document.getElementById('feedback-success-state');
    const resetFormBtn = document.getElementById('reset-form-btn');

    feedbackForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!feedbackForm || !submitBtn) return;

      if (errorBox) {
        errorBox.hidden = true;
        errorBox.textContent = '';
      }

      // Validação básica do cliente
      const formData = new FormData(feedbackForm);
      const tipo = formData.get('tipo');
      const estrelas = formData.get('estrelas');
      const categoria = formData.get('categoria');
      const mensagem = String(formData.get('mensagem') || '').trim();
      const isAnonimo = formData.get('anonimo') === 'true';

      if (!tipo) {
        showError('Por favor, selecione se é uma Sugestão, Elogio ou Reclamação.');
        return;
      }
      if (!estrelas) {
        showError('Por favor, selecione de 1 a 5 estrelas para avaliar sua experiência.');
        return;
      }
      if (!categoria) {
        showError('Por favor, selecione sobre o que você deseja falar na lista de áreas.');
        return;
      }
      if (mensagem.length < 10) {
        showError('Por favor, escreva uma mensagem com pelo menos 10 caracteres.');
        return;
      }
      if (!isAnonimo) {
        const nome = String(formData.get('nome') || '').trim();
        const email = String(formData.get('email') || '').trim();
        if (nome.length < 2) {
          showError('Por favor, informe seu nome completo ou opte pelo envio anônimo.');
          return;
        }
        if (!email.includes('@') || email.length < 5) {
          showError('Por favor, informe um endereço de e-mail válido.');
          return;
        }
      }

      // Submissão assíncrona
      submitBtn.disabled = true;
      const btnText = submitBtn.querySelector('.btn-text');
      const btnLoader = submitBtn.querySelector('.btn-loader');
      if (btnText) btnText.textContent = 'ENVIANDO MANIFESTAÇÃO...';
      if (btnLoader) btnLoader.removeAttribute('hidden');

      try {
        const response = await fetch('/api/feedbacks', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Não foi possível registrar sua manifestação.');
        }

        // Sucesso
        feedbackForm.hidden = true;
        if (successState) successState.hidden = false;
        successState?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err: any) {
        showError(err.message || 'Ocorreu um erro ao enviar. Tente novamente.');
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'ENVIAR MANIFESTAÇÃO';
        if (btnLoader) btnLoader.setAttribute('hidden', '');
      }
    });

    function showError(msg: string) {
      if (errorBox) {
        errorBox.textContent = msg;
        errorBox.hidden = false;
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    resetFormBtn?.addEventListener('click', () => {
      if (feedbackForm && successState) {
        feedbackForm.reset();
        feedbackForm.hidden = false;
        successState.hidden = true;
        updateStarDisplay(0);
        if (charCounter) charCounter.textContent = '0 / 2000';
        toggleIdentification(false);
        feedbackForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Inscrição na Newsletter / Comunidade VIP
    const nlForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const nlSubmitBtn = document.getElementById('nl-submit-btn') as HTMLButtonElement | null;
    const nlErrorBox = document.getElementById('nl-error-box');
    const nlSuccessBox = document.getElementById('nl-success-box');
    const nlSuccessMsg = document.getElementById('nl-success-msg');

    nlForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!nlForm || !nlSubmitBtn) return;

      if (nlErrorBox) {
        nlErrorBox.hidden = true;
        nlErrorBox.style.display = 'none';
        nlErrorBox.textContent = '';
      }
      if (nlSuccessBox) {
        nlSuccessBox.hidden = true;
        nlSuccessBox.style.display = 'none';
      }

      const formData = new FormData(nlForm);
      const nome = String(formData.get('nome') || '').trim();
      const email = String(formData.get('email') || '').trim();
      const whatsapp = String(formData.get('whatsapp') || '').trim();

      if (nome.length < 2) {
        showNlError('Por favor, informe seu nome completo.');
        return;
      }
      if (!email.includes('@') || email.length < 5) {
        showNlError('Por favor, informe um endereço de e-mail válido.');
        return;
      }
      if (whatsapp.length < 8) {
        showNlError('Por favor, informe seu número de WhatsApp com DDD.');
        return;
      }

      nlSubmitBtn.disabled = true;
      const btnText = nlSubmitBtn.querySelector('.btn-text');
      const btnLoader = nlSubmitBtn.querySelector('.btn-loader');
      if (btnText) btnText.textContent = 'CADASTRANDO...';
      if (btnLoader) btnLoader.removeAttribute('hidden');

      try {
        const response = await fetch('/api/newsletter', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Não foi possível cadastrar seu contato.');
        }

        // Sucesso real: esconde o formulário e mostra a caixa de confirmação
        nlForm.hidden = true;
        nlForm.style.display = 'none';
        if (nlSuccessBox) {
          nlSuccessBox.hidden = false;
          nlSuccessBox.style.display = 'flex';
          if (nlSuccessMsg && result.message) {
            nlSuccessMsg.textContent = result.message;
          }
        }
      } catch (err: any) {
        showNlError(err.message || 'Erro ao conectar. Tente novamente.');
      } finally {
        nlSubmitBtn.disabled = false;
        if (btnText) btnText.textContent = 'QUERO RECEBER AS NOVIDADES 🚀';
        if (btnLoader) btnLoader.setAttribute('hidden', '');
      }
    });

    function showNlError(msg: string) {
      if (nlErrorBox) {
        nlErrorBox.textContent = msg;
        nlErrorBox.hidden = false;
        nlErrorBox.style.display = 'block';
      }
    }
  </script>
</BaseLayout>
