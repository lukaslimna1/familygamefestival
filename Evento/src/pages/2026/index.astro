---
import { existsSync, readdirSync } from 'node:fs';
import { basename, extname, join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventSchedule from '../../components/EventSchedule.astro';
import HomeCompetitionAccordion from '../../components/HomeCompetitionAccordion.astro';
import SponsorHierarchy from '../../components/SponsorHierarchy.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { event, guests, attractions, artistAlleyArtists, stores, mediaPartners, experiences, tickets, vipTickets, competitorTickets } from '../../data/event';
import { competitionDays, getChampionshipEntry } from '../../data/championships';
import { ONLINE_REGISTRATION_DEADLINE_LABEL, ONLINE_REGISTRATION_ONSITE_NOTICE } from '../../config/registration-deadline';

export const prerender = true;

const homeCompetitionPanels = competitionDays.map((day) => {
  const entries = day.groups.flatMap((group) => group.entries);
  const featuredEntries = entries.filter((entry) => 'featured' in entry.tournament && entry.tournament.featured);
  const groupedEntries = day.groups
    .map((group) => ({ ...group, entries: group.entries.filter((entry) => !('featured' in entry.tournament && entry.tournament.featured)) }))
    .filter((group) => group.entries.length > 0);
  return { ...day, entries, featuredEntries, groupedEntries };
});

const competitorTicketEntries = competitorTickets.map((ticket) => {
  const entry = getChampionshipEntry(ticket.tournamentId)!;
  return { ...ticket, tournament: entry.tournament, schedule: entry.schedule, registrationFree: 'registrationFree' in entry.tournament && entry.tournament.registrationFree, eventAccessNote: entry.eventAccessNote };
});
const competitorTicketDays = [
  { day: 'SÁBADO', date: '19/09', slug: 'sabado' },
  { day: 'DOMINGO', date: '20/09', slug: 'domingo' }
].map((ticketDay) => ({
  ...ticketDay,
  entries: competitorTicketEntries.filter((entry) => entry.schedule.day === ticketDay.day)
}));
const guestVideoDirectory = join(process.cwd(), 'public/assets/videos');
const guestVideoOrder: Record<string, number> = {
  'Raul.mp4': 0,
  'Lana.mp4': 1,
  'Hélia de Cosplay.mp4': 2,
  'Bruno Werner.mp4': 3,
  'Diga Ação Podcast.mp4': 4,
  'zoofiss.mp4': 5
};
const guestVideoTitles: Record<string, string> = {
  'Bruno Werner.mp4': 'Bruno Werner',
  'Diga Ação Podcast.mp4': 'Diga Ação Podcast',
  'zoofiss.mp4': 'Zoofiss'
};
const guestVideos = existsSync(guestVideoDirectory)
  ? readdirSync(guestVideoDirectory, { withFileTypes: true })
      .filter((entry) => entry.isFile() && /\.(mp4|webm|mov|m4v)$/i.test(entry.name))
      .sort((a, b) => (guestVideoOrder[a.name] ?? Number.MAX_SAFE_INTEGER) - (guestVideoOrder[b.name] ?? Number.MAX_SAFE_INTEGER) || a.name.localeCompare(b.name, 'pt-BR'))
      .map((entry) => {
        const extension = extname(entry.name).toLowerCase();
        const filenameTitle = basename(entry.name, extension).replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
        const guest = guests.find((item) => filenameTitle.toLowerCase().startsWith(item.name.split(' ')[0].toLowerCase()));
        return { filename: entry.name, title: guestVideoTitles[entry.name] ?? guest?.name ?? filenameTitle, sourceType: extension === '.webm' ? 'video/webm' : extension === '.mov' ? 'video/quicktime' : 'video/mp4' };
      })
  : [];

const siteUrl = 'https://familygamefestival.vercel.app';
const absoluteAssetUrl = (path: string) => new URL(path, siteUrl).toString();
const guestSchemas = guests.map((guest) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/2026#guest-${guest.slug}`,
  name: guest.name,
  jobTitle: guest.role,
  description: guest.description,
  url: `${siteUrl}/2026#presencas-confirmadas`,
  sameAs: [guest.instagramUrl],
  image: absoluteAssetUrl(guest.image)
}));
const artistAlleySchemas = artistAlleyArtists.map((artist) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/2026#artist-${artist.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
  name: artist.name,
  jobTitle: artist.role,
  description: artist.description,
  url: `${siteUrl}/2026#artist-alley`,
  sameAs: [artist.instagramUrl],
  image: absoluteAssetUrl(artist.image)
}));
const attractionsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Atrações do Family Game Festival 2026',
  url: `${siteUrl}/2026#atracoes`,
  itemListElement: attractions.map((attraction, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: attraction.title,
    description: attraction.text,
    url: `${siteUrl}/2026#atracoes`
  }))
};
const homeStructuredData = [...guestSchemas, ...artistAlleySchemas, attractionsSchema];
---

<BaseLayout
  title="Arquivo Oficial 2026 | Family Game Festival"
  description="Reviva o Family Game Festival 2026 em Bauru/SP: histórico de atrações, campeonatos, convidados, cosplay, K-Pop e regulamentos da 1ª edição."
  canonical={`${siteUrl}/2026`}
  structuredData={homeStructuredData}
>
  <div class="archive-bar">
    <div class="container archive-bar-inner">
      <div class="archive-bar-info">
        <span class="archive-pill">ARQUIVO 2026</span>
        <p>Você está na memória oficial da 1ª edição do <strong>Family Game Festival</strong>.</p>
      </div>
      <div class="archive-bar-ctas">
        <a class="button button-small button-outline-light" href="/">← Voltar ao Início</a>
        <a class="button button-small button-yellow" href="/#feedback">Deixar Feedback ★</a>
      </div>
    </div>
  </div>

  <SiteHeader />

  <section class="event-spotlight" aria-labelledby="event-spotlight-title">
    <div class="container">
      <div class="event-spotlight-shell">
        <div class="event-spotlight-main">
          <div class="event-spotlight-heading">
            <p class="eyebrow eyebrow-yellow">Edição realizada com sucesso · Bauru/SP</p>
            <h2 id="event-spotlight-title">A história da 1ª edição.</h2>
          </div>
          <div class="event-spotlight-facts" aria-label="Data, local e horário do evento">
            <div class="event-spotlight-fact"><span>DATA</span><strong>19 e 20</strong><small>SETEMBRO DE 2026</small></div>
            <div class="event-spotlight-fact"><span>LOCAL</span><strong>SORRI</strong><small>BAURU · ARENA TAUSTE</small></div>
            <div class="event-spotlight-fact"><span>HORÁRIO</span><strong>{event.hours}</strong><small>HORÁRIO DO EVENTO</small></div>
          </div>
        </div>

        <div class="event-countdown" role="region" aria-label="Status do evento">
          <div class="event-countdown-heading"><span>EDIÇÃO ENCERRADA</span><strong>OBRIGADO A TODOS!</strong></div>
          <p style="margin: 8px 0 0; font-size: 13px; color: rgba(255,255,255,.75); line-height: 1.4;">
            Dois dias de emoção, games, cosplay e muita festa em Bauru.
          </p>
        </div>
      </div>
    </div>
  </section>

  <main>
    <section class="hero" id="inicio">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> 1ª edição · Bauru, SP</p>
          <h1>Family Game Festival <em>2026.</em></h1>
          <p class="hero-lead">Um evento geek e gamer em Bauru/SP com dois dias de games, campeonatos, dança, cosplay, dublagem e cultura pop para jogar junto.</p>
          <div class="hero-actions">
            <a class="button button-yellow" href="/#feedback">Deixar meu feedback <span aria-hidden="true">★</span></a>
            <a class="text-link" href="#campeonatos">Ver campeonatos <span aria-hidden="true">↓</span></a>
          </div>
          <div class="event-facts" aria-label="Informações principais do evento">
            <div><strong>19—20</strong><span>setembro de 2026</span></div>
            <div><strong>SORRI</strong><span>Bauru · Arena Tauste</span></div>
            <div><strong>{event.hours}</strong><span>horário do evento</span></div>
          </div>
        </div>

        <div class="hero-stage" aria-label="Identidade visual do Family Game Festival">
          <div class="stage-topline"><span>FAMILY GAME FESTIVAL</span><span>FGF / 26</span></div>
          <div class="stage-art">
            <img class="stage-grid" src="/assets/svg/grid.svg" alt="" aria-hidden="true" />
            <img class="stage-lines" src="/assets/svg/interface-lines.svg" alt="" aria-hidden="true" />
            <span class="stage-label stage-label-top">GAME · GEEK · CULTURE</span>
            <img class="stage-logo" src="/assets/logo.svg" alt="Family Game Festival 2026" />
            <img class="stage-mascot" src="/assets/mascots/0 - Pose Original.svg" alt="Mascote do Family Game Festival" />
            <span class="stage-chip chip-cyan">PLAY</span>
            <span class="stage-chip chip-pink">LEVEL 01</span>
            <span class="stage-label stage-label-bottom">19—20 SET · BAURU/SP</span>
          </div>
          <div class="stage-bottomline"><span>ARENA TAUSTE</span><span class="stage-stars">✦ ✦ ✦</span></div>
        </div>
      </div>
    </section>

    <EventSchedule />

    <section class="section section-dark intro-section">
      <div class="container intro-grid">
        <div>
          <p class="eyebrow eyebrow-cyan">O festival</p>
          <h2>Uma arena para quem joga, dança, cria e compartilha.</h2>
        </div>
        <div class="intro-copy">
          <p>{event.experienceLine}</p>
          <p>{event.socialImpact} É um festival de games e cultura geek com impacto social associado.</p>
          <a class="text-link text-link-light" href={event.instagramUrl} target="_blank" rel="noreferrer">Acompanhar no Instagram <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="section section-light attractions-section" id="atracoes">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-red">O que rolou</p><h2>Experiências inesquecíveis.</h2></div>
          <p class="heading-note">Experiências para quem competiu, assistiu, colecionou ou passou um dia diferente com a família.</p>
          <img class="section-mascot section-mascot-strength" src="/assets/mascots/2 - Pose Força.svg" alt="" aria-hidden="true" />
        </div>

        <div class="attraction-grid">
          {attractions.map((item, index) => (
            <article class={`attraction-card accent-${item.accent}`}>
              <div class="card-index">0{index + 1}</div>
              <img src={`/assets/svg/${item.icon}`} alt="" aria-hidden="true" />
              <p class="card-eyebrow">{item.eyebrow}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <div class="section-heading guest-heading" id="presencas-confirmadas">
          <div><p class="eyebrow eyebrow-pink">Presenças do evento</p><h2>Gente que transformou a arena.</h2></div>
        </div>
        <div class="guest-grid">
          {guests.map((guest) => (
            <article class={`guest-card guest-${guest.accent} guest-${guest.slug}`}>
              <div class="guest-art">
                <span class="guest-art-label">{guest.badge}</span>
                {guest.image ? (
                  <img src={guest.image} alt={`${guest.name} no Family Game Festival`} loading="lazy" />
                ) : (
                  <div class="guest-mystery-art" role="img" aria-label="Identidade do convidado">
                    <strong>✦</strong>
                    <span>CONVIDADO</span>
                  </div>
                )}
                <span class="guest-art-number">FGF 26</span>
              </div>
              <div class="guest-content">
                <p class="card-eyebrow">{guest.role}</p>
                <h3>{guest.name}</h3>
                <p>{guest.description}</p>
                <p class="guest-highlight">{guest.highlight}</p>
                {guest.instagramUrl ? (
                  <a class="text-link" href={guest.instagramUrl} target="_blank" rel="noreferrer">{guest.handle} <span aria-hidden="true">↗</span></a>
                ) : null}
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <section class="section section-dark guest-videos-section" id="videos" aria-labelledby="guest-videos-title">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-cyan">Conteúdo dos convidados</p><h2 id="guest-videos-title">Vídeos que entraram em cena.</h2></div>
          <p class="heading-note heading-note-light">Recados, convites, bastidores e apresentações dos convidados do Family Game Festival.</p>
          <img class="section-mascot section-mascot-here" src="/assets/mascots/5 - Pose Convidando.svg" alt="" aria-hidden="true" />
        </div>

        <div class="guest-video-grid">
          {guestVideos.map((video) => (
            <article class="guest-video-card">
              <div class="guest-video-media">
                <video controls preload="metadata" aria-label={`Vídeo de ${video.title}`}>
                  <source src={`/assets/videos/${encodeURIComponent(video.filename)}`} type={video.sourceType} />
                  Seu navegador não consegue reproduzir este vídeo.
                </video>
              </div>
              <div class="guest-video-content">
                <p class="card-eyebrow">Vídeo do convidado</p>
                <h3>{video.title}</h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-light exhibitors-section" id="expositores" aria-labelledby="exhibitors-title">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-cyan">Expositores</p><h2 id="exhibitors-title">Lojas e Artist Alley.</h2></div>
          <p class="heading-note">Lojas que estiveram na arena e artistas independentes do festival.</p>
          <img class="section-mascot section-mascot-ok" src="/assets/mascots/4 - Pose Ok.svg" alt="" aria-hidden="true" />
        </div>

        <section class="artist-alley stores-showcase" id="lojas" aria-labelledby="stores-title">
          <div class="artist-alley-header">
            <div><p class="eyebrow eyebrow-yellow">Lojas</p><h3 id="stores-title">Lojas</h3></div>
            <p>Produtos, games e novidades das lojas presentes no Family Game Festival.</p>
          </div>
          <div class="artist-alley-grid">
            {stores.map((store, index) => (
              <article class={`artist-alley-card store-card artist-alley-${store.accent}`}>
                <div class="artist-alley-art store-art"><img src={store.image} alt={`Logo ${store.name}`} loading="lazy" /></div>
                <div class="artist-alley-copy">
                  <span class="artist-alley-index">0{index + 1}</span>
                  <p class="card-eyebrow">{store.role}</p>
                  <h4>{store.name}</h4>
                  <p>{store.description}</p>
                  <a class="text-link" href={store.href} target="_blank" rel="noreferrer">{store.handle} <span aria-hidden="true">↗</span></a>
                  <span class="artist-alley-note">{store.note}</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="artist-alley artist-alley-showcase" id="artist-alley" aria-labelledby="artist-alley-title">
          <div class="artist-alley-header">
            <div><p class="eyebrow eyebrow-cyan">Artist Alley</p><h3 id="artist-alley-title">Artist Alley</h3></div>
            <p>A área com lojinhas dos talentosos artistas independentes do festival.</p>
          </div>
          <div class="artist-alley-grid">
            {artistAlleyArtists.map((artist, index) => (
              <article class={`artist-alley-card artist-alley-${artist.accent}`}>
                <div class="artist-alley-art"><img src={artist.image} alt={`${artist.name} no Artist Alley do Family Game Festival`} loading="lazy" /></div>
                <div class="artist-alley-copy">
                  <span class="artist-alley-index">0{index + 1}</span>
                  <p class="card-eyebrow">{artist.role}</p>
                  <h4>{artist.name}</h4>
                  <p>{artist.description}</p>
                  <p class="artist-alley-detail">{artist.detail}</p>
                  <a class="text-link" href={artist.instagramUrl} target="_blank" rel="noreferrer">{artist.handle} <span aria-hidden="true">↗</span></a>
                  <span class="artist-alley-note">{artist.note}</span>
                </div>
              </article>
            ))}
          </div>
        </section>
      </div>
    </section>

    <section class="section section-navy tournaments-section" id="campeonatos">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-yellow">Histórico competitivo</p><h2>Os campeonatos da edição 2026.</h2></div>
          <img class="section-mascot section-mascot-fight" src="/assets/mascots/3 - Pose Luta.svg" alt="" aria-hidden="true" />
        </div>

        <div class="tournament-day-tabs" role="tablist" aria-label="Escolha o dia dos campeonatos">
          {homeCompetitionPanels.map((panel, index) => (
            <button class={`tournament-day-tab ${index === 0 ? 'is-active' : ''}`} id={`home-${panel.slug}-tab`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`home-${panel.slug}-panel`} data-home-day-tab={panel.slug}>
              <span>{panel.day}</span><small>{panel.date}</small>
            </button>
          ))}
        </div>

        {homeCompetitionPanels.map((panel, panelIndex) => (
          <div class={`home-competition-panel tournament-day-panel ${panelIndex === 0 ? 'is-active' : ''}`} id={`home-${panel.slug}-panel`} role="tabpanel" aria-labelledby={`home-${panel.slug}-tab`} data-home-day-panel={panel.slug} hidden={panelIndex !== 0}>
            <div class="home-competition-list">
              {panel.featuredEntries.length > 0 && (
                <div class={`competition-group competition-special-group ${panel.featuredEntries.length === 1 ? 'competition-special-group-single' : ''}`}>
                  <div class="competition-group-heading">
                    <div><p class="card-eyebrow">Destaque do palco</p><h3>{panel.featuredEntries[0].tournament.category === 'Dance Game' ? 'Competição de Dança' : 'Cosplay'}</h3></div>
                    <span>{panel.featuredEntries.length} {panel.featuredEntries.length === 1 ? 'atração' : 'atrações'}</span>
                  </div>
                  <div class="home-competition-accordion-list">
                    {panel.featuredEntries.map((entry) => <HomeCompetitionAccordion entry={entry} categoryLabel={entry.tournament.category === 'Dance Game' ? 'Competição de Dança' : 'Cosplay'} featured />)}
                  </div>
                </div>
              )}

              {panel.groupedEntries.map((group) => (
                <div class={`competition-group competition-group-${group.accent}`}>
                  <div class="competition-group-heading">
                    <div><p class="card-eyebrow">{group.kicker}</p><h3>{group.title}</h3></div>
                    <span>{group.entries.length} disputas</span>
                  </div>
                  <div class="home-competition-accordion-list">
                    {group.entries.map((entry, index) => <HomeCompetitionAccordion entry={entry} categoryLabel={group.kicker} number={index + 1} />)}
                  </div>
                </div>
              ))}

            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section section-light experiences-section">
      <div class="container">
        <div class="section-heading section-heading-with-mascot"><p class="eyebrow eyebrow-cyan">Experiências vividas</p><h2>Um mapa inteiro de diversão.</h2><img class="section-mascot section-mascot-ok" src="/assets/mascots/4 - Pose Ok.svg" alt="" aria-hidden="true" /></div>
        <div class="experience-grid">
          {experiences.map((experience) => (
            <article class="experience-card">
              <span class="experience-number">{experience.number}</span>
              <img src={`/assets/svg/${experience.icon}`} alt="" aria-hidden="true" />
              <h3>{experience.title}</h3>
              <p>{experience.text}</p>
            </article>
          ))}
        </div>
        <div class="inclusive-note"><img src="/assets/svg/controller.svg" alt="" aria-hidden="true" /><p><strong>Todo mundo tem espaço na partida.</strong> O festival preparou competições e experiências inclusivas para pessoas com deficiência com impacto social pela SORRI Bauru.</p></div>
      </div>
    </section>

    <section class="section sponsor-home-section" id="patrocinadores">
      <div class="container">
        <div class="section-heading heading-row sponsor-home-heading">
          <div><p class="eyebrow eyebrow-red">Patrocinadores e apoiadores</p><h2>Quem fez o jogo acontecer.</h2></div>
        </div>

        <SponsorHierarchy carousel>
          <div slot="after-hierarchy" class="sponsor-inline-cta">
            <div class="sponsor-inline-cta-copy"><p class="eyebrow eyebrow-yellow">Quer apoiar as próximas iniciativas?</p><h3>Conheça as marcas que fortaleceram o festival.</h3></div>
            <a class="button button-yellow" href="/patrocinadores/como-participar">Mais sobre patrocinadores <span aria-hidden="true">↗</span></a>
            <img class="sponsor-inline-cta-mascot" src="/assets/mascots/5 - Pose Convidando.svg" alt="" aria-hidden="true" />
          </div>
        </SponsorHierarchy>
      </div>
    </section>

    <section class="section press-kit-home-section" id="para-quem-divulga" aria-labelledby="media-support-title">
      <div class="container">
        <div class="section-heading heading-row media-support-heading">
          <div><p class="eyebrow eyebrow-cyan">Imprensa</p><h2 id="media-support-title">Parceiros de divulgação.</h2></div>
          <p class="heading-note heading-note-light">Parceiros que ajudaram o Family Game Festival a chegar mais longe por meio da cobertura de imprensa.</p>
        </div>
        <div class="sponsor-carousel-band media-support-carousel-band" aria-label="Parceiros de divulgação">
          <div class="sponsor-carousel-viewport">
            <div class="sponsor-carousel-track">
              {[...mediaPartners, ...mediaPartners].map((media, index) => {
                const duplicate = index >= mediaPartners.length;
                const logoClass = 'lightLogo' in media && media.lightLogo
                  ? 'sponsor-carousel-logo sponsor-carousel-logo-light'
                  : 'sponsor-carousel-logo';
                return (
                  <a class={`sponsor-carousel-item sponsor-carousel-${media.accent}`} href={media.href} target="_blank" rel="noreferrer" aria-label={`${media.name} · parceiro de divulgação`} title={`${media.name} · parceiro de divulgação`} aria-hidden={duplicate ? 'true' : undefined} tabindex={duplicate ? -1 : undefined}>
                    <span class={logoClass}><img src={media.image} alt={`Logo ${media.name}`} loading="lazy" /></span>
                    <span class="sponsor-carousel-pill">Parceiro de divulgação</span>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-top"><a class="brand" href="/"><img src="/assets/logo.svg" alt="Family Game Festival" /></a><p>Games, cultura geek e impacto local.<br />Bauru · 19—20 setembro 2026</p><a class="button button-yellow button-small" href="/#feedback">Deixar Feedback ★</a></div>
    <div class="container footer-bottom"><span>© 2026 Family Game Festival · Edição 2026</span><a href={event.instagramUrl} target="_blank" rel="noreferrer">{event.instagram}</a><span>Parte da arrecadação foi revertida para a SORRI Bauru.</span><span class="footer-credit">Desenvolvido pela <a href="https://www.instagram.com/usealterstate/" target="_blank" rel="noreferrer">ALTERSTATE</a></span></div>
  </footer>

  <style>
    .archive-bar {
      background: #060e19;
      border-bottom: 1px solid rgba(255, 201, 40, .25);
      padding: 12px 0;
      color: #fff;
    }
    .archive-bar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .archive-bar-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .archive-bar-info p {
      margin: 0;
      font-size: 14px;
      color: rgba(255, 255, 255, .82);
    }
    .archive-bar-info strong {
      color: var(--yellow);
    }
    .archive-pill {
      display: inline-block;
      padding: 4px 10px;
      background: var(--yellow);
      color: var(--navy);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .08em;
      border-radius: 3px;
    }
    .archive-bar-ctas {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    @media (max-width: 640px) {
      .archive-bar-inner {
        flex-direction: column;
        align-items: flex-start;
      }
      .archive-bar-ctas {
        width: 100%;
        justify-content: space-between;
      }
    }
  </style>

  <script>
    const homeDayTabs = document.querySelectorAll<HTMLButtonElement>('[data-home-day-tab]');
    const homeDayPanels = document.querySelectorAll<HTMLElement>('[data-home-day-panel]');

    const activateHomeDay = (slug: string) => {
      homeDayTabs.forEach((tab) => {
        const active = tab.getAttribute('data-home-day-tab') === slug;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      homeDayPanels.forEach((panel) => {
        const active = panel.getAttribute('data-home-day-panel') === slug;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    };

    homeDayTabs.forEach((tab) => tab.addEventListener('click', () => {
      const slug = tab.getAttribute('data-home-day-tab');
      if (slug) activateHomeDay(slug);
    }));

    document.querySelectorAll<HTMLElement>('[data-home-competition-item]').forEach((item) => {
      const toggle = item.querySelector<HTMLButtonElement>('[data-home-competition-toggle]');
      const details = item.querySelector<HTMLElement>('[data-home-competition-details]');
      if (!toggle || !details) return;

      toggle.addEventListener('click', () => {
        const expanded = item.classList.toggle('is-expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        details.hidden = !expanded;
      });
    });
  </script>
</BaseLayout>
