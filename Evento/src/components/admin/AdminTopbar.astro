---
import AdminIcon from './AdminIcon.astro';

interface Props {
  title: string;
  subtitle?: string;
  action?: { label: string; href: string };
  admin?: { displayName: string };
  search?: { action: string; value?: string; placeholder?: string };
  notificationCount?: number;
}

const { title, subtitle, action, admin, search, notificationCount = 0 } = Astro.props;
const initials = admin?.displayName
  ?.split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('');
---

<header class="admin-topbar">
  <div class="admin-topbar-heading">
    <button
      class="admin-menu-toggle"
      type="button"
      data-admin-menu-toggle
      aria-controls="admin-sidebar"
      aria-expanded="false"
      aria-label="Abrir menu administrativo"
    >
      <AdminIcon name="menu" />
    </button>
    <div>
      <p class="admin-topbar-kicker">Family Game Festival · área administrativa</p>
      <h1>{title}</h1>
      {subtitle && <p class="admin-topbar-subtitle">{subtitle}</p>}
    </div>
  </div>

  <div class="admin-topbar-actions">
    {search && (
      <form class="admin-topbar-search" method="get" action={search.action} role="search">
        <AdminIcon name="search" />
        <input name="q" value={search.value ?? ''} placeholder={search.placeholder ?? 'Buscar'} aria-label={search.placeholder ?? 'Buscar'} />
      </form>
    )}
    {notificationCount > 0 && (
      <a class="admin-topbar-notification" href="/admin/menores?status=pending" aria-label={String(notificationCount) + ' pendências'}>
        <span class="admin-notification-dot" aria-hidden="true"></span>
        <strong>{notificationCount > 99 ? '99+' : notificationCount}</strong>
      </a>
    )}
    {action && (
      <a class="admin-topbar-action" href={action.href}>
        <span>{action.label}</span>
        <AdminIcon name="arrow" />
      </a>
    )}
    {admin && (
      <details class="admin-account-menu">
        <summary class="admin-topbar-user" aria-label={'Menu da conta de ' + admin.displayName}>
          <span class="admin-topbar-avatar" aria-hidden="true">{initials || 'A'}</span>
          <span class="admin-topbar-user-copy">
            <strong>{admin.displayName}</strong>
            <small>Administrador</small>
          </span>
        </summary>
        <div class="admin-account-menu-panel">
          <a href="/admin/configuracoes">Minha conta</a>
          <a href="/admin/account/password">Trocar senha</a>
          <form method="post" action="/api/admin/logout"><button type="submit">Sair</button></form>
        </div>
      </details>
    )}
  </div>
</header>
