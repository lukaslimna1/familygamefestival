---
import AudioUploadField from './AudioUploadField.astro';

interface Props {
  step?: string;
}

const { step = '05' } = Astro.props;
---

<div class="registration-section" id="audio">
  <div class="registration-section-heading"><span>{step}</span><div><p class="eyebrow eyebrow-pink">Áudio da apresentação</p><h3>Identifique e envie seu áudio.</h3></div></div>
  <p class="registration-helper">O áudio é opcional nesta etapa. Aceitamos MP3, M4A ou WAV; MP4 não é aceito. Você poderá substituir ou remover o arquivo depois.</p>
  <div class="registration-field registration-audio-title-field">
    <label for="audio-title">Identificação do áudio <span class="registration-optional">(opcional)</span></label>
    <span class="registration-field-helper">Dê um nome para a organização localizar o arquivo com facilidade.</span>
    <input id="audio-title" name="audioTitle" type="text" placeholder="Ex.: Trilha da apresentação da Sakura" />
  </div>
  <AudioUploadField />
</div>
