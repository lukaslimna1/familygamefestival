---
import BaseLayout from '../layouts/BaseLayout.astro';
import { event } from '../data/event';
import {
  getPublicTestimonials,
  getPublicMetrics,
  FEEDBACK_CATEGORIES
} from '../lib/server/feedback/repository';

export const prerender = false;

const testimonials = await getPublicTestimonials(12);
const metrics = await getPublicMetrics();

const siteUrl = 'https://familygamefestival.vercel.app';
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Family Game Festival',
  url: siteUrl,
  description: 'Portal pós-evento do Family Game Festival. Obrigado por jogar com a gente! Deixe seu feedback, confira depoimentos e acesse a memória oficial da edição 2026.'
};
---

<BaseLayout
  title="Family Game Festival | Obrigado por Jogar com a Gente!"
  description="O Family Game Festival 2026 chegou ao fim. Obrigado por jogar com a gente! Envie seu feedback, reviva a edição 2026 e confira fotos e vídeos oficiais."
  canonical={siteUrl}
  structuredData={homeStructuredData}
>
  <div id="inicio" class="page-top-anchor" aria-hidden="true"></div>

  <!-- Header Pós-Evento -->
  <header class="post-header">
    <div class="container post-header-inner">
      <a class="post-brand" href="#inicio" aria-label="Family Game Festival · início">
        <img src="/assets/logo.svg" alt="Family Game Festival" width="132" height="38" />
      </a>

      <nav class="post-nav" id="post-nav" aria-label="Navegação principal">
        <a class="post-nav-link is-current" href="#inicio">INÍCIO</a>
        <a class="post-nav-link" href="#feedback">FEEDBACK</a>
        <a class="post-nav-link" href="#depoimentos">DEPOIMENTOS</a>
        <a class="post-nav-link" href="#snaps">FGF SNAP</a>
        <a class="post-nav-link" href="#newsletter">NOVIDADES</a>
        <a class="post-nav-link" href="/2026">FGF 2026</a>
        <a class="post-nav-link" href={event.instagramUrl} target="_blank" rel="noopener noreferrer">
          INSTAGRAM <span class="nav-arrow" aria-hidden="true">↗</span>
        </a>
      </nav>

      <div class="post-header-cta">
        <a class="button button-yellow button-small" href="#feedback">
          Deixar Feedback ★
        </a>
      </div>
    </div>
  </header>

  <main class="post-event-main">
    <!-- Hero Pós-Evento -->
    <section class="post-hero" aria-labelledby="post-hero-title">
      <div class="hero-backdrop" aria-hidden="true">
        <div class="ambient-glow ambient-cyan"></div>
        <div class="ambient-glow ambient-yellow"></div>
        <div class="pixel-matrix"></div>
      </div>

      <div class="container post-hero-content">
        <div class="post-hero-badge">
          <span class="badge-dot"></span>
          <span class="badge-label">FAMILY GAME FESTIVAL 2026 · EDIÇÃO REALIZADA</span>
        </div>

        <h1 id="post-hero-title" class="post-hero-title">
          OBRIGADO POR JOGAR <br />
          <span class="title-highlight">COM A GENTE.</span>
        </h1>

        <p class="post-hero-lead">
          O Family Game Festival 2026 chegou ao fim. <br class="mobile-hide" />
          Mas essa história continua sendo construída com você.
        </p>

        <div class="post-hero-actions">
          <a class="button button-yellow post-cta-primary" href="#feedback">
            <span>DEIXAR MEU FEEDBACK</span>
            <span class="cta-icon" aria-hidden="true">★</span>
          </a>
          <a class="button button-outline-cyan post-cta-secondary" href="#snaps">
            <span>CRIAR MEU SNAP</span>
            <span class="cta-icon" aria-hidden="true">📸</span>
          </a>
          <a class="button button-outline-light post-cta-secondary" href="/2026">
            <span>REVIVER O FGF 2026</span>
            <span class="cta-icon" aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Barra de Destaques Rápidos -->
        <div class="post-highlights-bar" aria-label="Resumo do evento">
          <div class="highlight-item">
            <span class="highlight-label">CIDADE</span>
            <strong class="highlight-value">BAURU · SP</strong>
            <small class="highlight-desc">Arena Tauste · SORRI</small>
          </div>
          <div class="highlight-divider" aria-hidden="true"></div>
          <div class="highlight-item">
            <span class="highlight-label">DATA HISTÓRICA</span>
            <strong class="highlight-value">19 E 20 SET 2026</strong>
            <small class="highlight-desc">1ª Edição Oficial</small>
          </div>
          <div class="highlight-divider" aria-hidden="true"></div>
          <div class="highlight-item">
            <span class="highlight-label">STATUS</span>
            <strong class="highlight-value text-yellow">PÓS-EVENTO</strong>
            <small class="highlight-desc">Ouvindo nossa comunidade</small>
          </div>
        </div>
      </div>
    </section>

    <!-- Seção de Feedback Completa -->
    <section class="section feedback-section" id="feedback" aria-labelledby="feedback-section-title">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow eyebrow-yellow">SUA VOZ IMPORTA</p>
          <h2 id="feedback-section-title" class="feedback-heading-title">COMO FOI SUA EXPERIÊNCIA?</h2>
          <p class="section-subtitle">
            Compartilhe sua percepção para nos ajudar a evoluir o Family Game Festival. <br class="mobile-hide" />
            Escolha abaixo o tipo de manifestação que deseja enviar:
          </p>
        </div>

        <!-- 3 Cards Seletores de Tipo -->
        <div class="type-selector-grid" role="group" aria-label="Selecione o tipo de feedback">
          <button
            type="button"
            class="type-card type-card-sugestao"
            data-type-btn="sugestao"
            aria-pressed="false"
          >
            <div class="type-card-header">
              <span class="type-badge badge-cyan">SUGESTÃO</span>
              <span class="type-icon-box" aria-hidden="true">💡</span>
            </div>
            <h3 class="type-card-title">Sugestão</h3>
            <p class="type-card-desc">“Tenho uma ideia para melhorar o evento.”</p>
            <span class="type-card-select-indicator">Selecionar sugestão</span>
          </button>

          <button
            type="button"
            class="type-card type-card-elogio"
            data-type-btn="elogio"
            aria-pressed="false"
          >
            <div class="type-card-header">
              <span class="type-badge badge-yellow">ELOGIO</span>
              <span class="type-icon-box" aria-hidden="true">🏆</span>
            </div>
            <h3 class="type-card-title">Elogio</h3>
            <p class="type-card-desc">“Quero contar algo que gostei.”</p>
            <span class="type-card-select-indicator">Selecionar elogio</span>
          </button>

          <button
            type="button"
            class="type-card type-card-reclamacao"
            data-type-btn="reclamacao"
            aria-pressed="false"
          >
            <div class="type-card-header">
              <span class="type-badge badge-red">RECLAMAÇÃO</span>
              <span class="type-icon-box" aria-hidden="true">⚠️</span>
            </div>
            <h3 class="type-card-title">Reclamação</h3>
            <p class="type-card-desc">“Algo não funcionou como deveria.”</p>
            <span class="type-card-select-indicator">Selecionar reclamação</span>
          </button>
        </div>

        <!-- Formulário Dinâmico de Feedback -->
        <div class="feedback-form-wrapper" id="feedback-form-container" hidden>
          <form id="feedback-form" class="feedback-form" novalidate>
            <!-- Honeypot invisível para bots -->
            <input type="text" name="hp_website" class="sr-only" tabindex="-1" autocomplete="off" />

            <input type="hidden" name="tipo" id="input-tipo" value="" />

            <div class="form-header-banner">
              <span class="form-selected-pill" id="form-selected-pill">SUGESTÃO</span>
              <p id="form-selected-desc">Preencha os campos abaixo para enviar sua sugestão à organização.</p>
            </div>

            <!-- Avaliação por Estrelas (1 a 5) -->
            <div class="form-group star-rating-group">
              <label class="form-label" id="star-rating-label">
                Como você avalia sua experiência no FGF 2026? <span class="required">*</span>
              </label>
              <div class="star-rating-shell" role="radiogroup" aria-labelledby="star-rating-label">
                {[1, 2, 3, 4, 5].map((num) => (
                  <label class="star-label" title={`${num} estrela${num > 1 ? 's' : ''}`}>
                    <input
                      type="radio"
                      name="estrelas"
                      value={num}
                      class="star-input"
                      required
                    />
                    <span class="star-symbol" aria-hidden="true">★</span>
                    <span class="sr-only">{num} estrela{num > 1 ? 's' : ''}</span>
                  </label>
                ))}
                <span class="star-caption" id="star-caption" aria-live="polite">Selecione uma nota</span>
              </div>
            </div>

            <!-- Categoria do Feedback -->
            <div class="form-group">
              <label for="categoria-select" class="form-label">
                Sobre o que você quer falar? <span class="required">*</span>
              </label>
              <div class="select-wrapper">
                <select id="categoria-select" name="categoria" class="form-select" required>
                  <option value="" disabled selected>Selecione uma área...</option>
                  {FEEDBACK_CATEGORIES.map((cat) => (
                    <option value={cat}>{cat}</option>
                  ))}
                </select>
                <span class="select-chevron" aria-hidden="true">⌄</span>
              </div>
            </div>

            <!-- Mensagem -->
            <div class="form-group">
              <div class="form-label-row">
                <label for="mensagem-textarea" class="form-label">
                  Conte pra gente. <span class="required">*</span>
                </label>
                <span class="char-counter" id="char-counter">0 / 2000</span>
              </div>
              <textarea
                id="mensagem-textarea"
                name="mensagem"
                class="form-textarea"
                rows="5"
                minlength="10"
                maxlength="2000"
                placeholder="Escreva aqui detalhadamente. Seja sincero e construtivo, sua opinião é lida com respeito e atenção..."
                required
              ></textarea>
            </div>

            <!-- Identificação -->
            <fieldset class="form-fieldset">
              <legend class="form-legend">Quer se identificar?</legend>
              <div class="radio-toggle-group" role="radiogroup">
                <label class="radio-toggle-card">
                  <input type="radio" name="anonimo" value="false" checked />
                  <div class="toggle-card-content">
                    <strong>Quero me identificar</strong>
                    <small>Seu nome e e-mail ficam seguros com a organização.</small>
                  </div>
                </label>
                <label class="radio-toggle-card">
                  <input type="radio" name="anonimo" value="true" />
                  <div class="toggle-card-content">
                    <strong>Quero enviar anonimamente</strong>
                    <small>Nenhum dado pessoal será vinculado à sua mensagem.</small>
                  </div>
                </label>
              </div>

              <div class="identified-fields" id="identified-fields">
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="nome-input" class="form-label">Nome completo <span class="required">*</span></label>
                    <input type="text" id="nome-input" name="nome" class="form-input" placeholder="Seu nome completo" />
                  </div>
                  <div class="form-group">
                    <label for="email-input" class="form-label">E-mail <span class="required">*</span></label>
                    <input type="email" id="email-input" name="email" class="form-input" placeholder="seuemail@exemplo.com" />
                  </div>
                </div>
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="telefone-input" class="form-label">Telefone / WhatsApp <span class="optional">(opcional)</span></label>
                    <input type="tel" id="telefone-input" name="telefone" class="form-input" placeholder="(14) 99999-9999" />
                  </div>
                  <div class="form-group">
                    <label for="instagram-input" class="form-label">@ do Instagram ou link <span class="optional">(opcional)</span></label>
                    <input type="text" id="instagram-input" name="instagram" class="form-input" placeholder="@seuusuario ou link do perfil" />
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- Permissão de Contato -->
            <div class="form-group checkbox-group" id="contact-permission-box">
              <label class="checkbox-label">
                <input type="checkbox" name="permiteContato" value="true" class="form-checkbox" />
                <span class="checkbox-box" aria-hidden="true"></span>
                <span class="checkbox-text">
                  Autorizo a organização do Family Game Festival a entrar em contato comigo sobre esta manifestação.
                </span>
              </label>
            </div>

            <!-- Autorização para Publicação -->
            <fieldset class="form-fieldset">
              <legend class="form-legend">
                Podemos compartilhar seu feedback nos canais oficiais do Family Game Festival? <span class="required">*</span>
              </legend>
              <p class="fieldset-desc">
                Depoimentos positivos e sugestões inspiradoras nos ajudam a divulgar a energia da comunidade.
                Nenhum feedback é tornado público sem o seu consentimento prévio.
              </p>
              <div class="publication-options">
                <label class="pub-option" id="pub-option-name">
                  <input type="radio" name="autorizacaoPublicacao" value="nome" checked />
                  <span class="pub-radio-circle"></span>
                  <span class="pub-option-copy">
                    <strong>Sim, com meu primeiro nome</strong>
                    <small>Exemplo: “Participante P.” acompanhado do seu relato.</small>
                  </span>
                </label>

                <label class="pub-option">
                  <input type="radio" name="autorizacaoPublicacao" value="anonimo" />
                  <span class="pub-radio-circle"></span>
                  <span class="pub-option-copy">
                    <strong>Sim, mas de forma anônima</strong>
                    <small>Seu depoimento será assinado apenas como “Participante FGF”.</small>
                  </span>
                </label>

                <label class="pub-option">
                  <input type="radio" name="autorizacaoPublicacao" value="nao" />
                  <span class="pub-radio-circle"></span>
                  <span class="pub-option-copy">
                    <strong>Não autorizo publicação</strong>
                    <small>Seu feedback será de uso estritamente interno da organização.</small>
                  </span>
                </label>
              </div>
            </fieldset>

            <div class="form-alert form-alert-error" id="form-error-box" hidden role="alert"></div>

            <!-- Botão de Envio -->
            <div class="form-footer">
              <button type="submit" class="button button-yellow form-submit-btn" id="submit-btn">
                <span class="btn-text">ENVIAR MANIFESTAÇÃO</span>
                <span class="btn-loader" hidden aria-hidden="true"></span>
              </button>
              <p class="form-disclaimer">
                Seus dados são tratados com responsabilidade de acordo com a LGPD.
              </p>
            </div>
          </form>

          <!-- Tela de Sucesso -->
          <div class="feedback-success-state" id="feedback-success-state" hidden role="status" aria-live="polite">
            <div class="success-icon-box">✓</div>
            <h3 class="success-title">RECEBEMOS SUA MENSAGEM.</h3>
            <p class="success-copy">
              Obrigado por ajudar a construir uma experiência melhor. <br />
              Todas as manifestações serão registradas e analisadas pela organização do Family Game Festival.
            </p>
            <div class="success-actions">
              <button type="button" class="button button-outline-light button-small" id="reset-form-btn">
                Enviar outra manifestação
              </button>
              <a href="#depoimentos" class="button button-yellow button-small">
                Ver depoimentos da comunidade ↓
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Seção de Depoimentos no Site ("O QUE VOCÊS DISSERAM") -->
    <section class="section testimonials-section" id="depoimentos" aria-labelledby="depoimentos-title">
      <div class="container">
        <div class="section-heading heading-row">
          <div>
            <p class="eyebrow eyebrow-cyan">VOZ DA COMUNIDADE</p>
            <h2 id="depoimentos-title" style="color: #ffffff !important;">O QUE VOCÊS DISSERAM</h2>
          </div>
          {metrics.hasQuorum && (
            <div class="community-metrics-pill" aria-label="Média de avaliação da comunidade">
              <span class="metrics-star">★</span>
              <strong>{metrics.mediaFormatada} / 5</strong>
              <small>({metrics.total} avaliações reais)</small>
            </div>
          )}
        </div>

        {testimonials.length > 0 ? (
          <div class="testimonials-scroller" tabIndex={0} aria-label="Depoimentos de participantes">
            <div class="testimonials-grid">
              {testimonials.map((item) => (
                <article class:list={['testimonial-card', { 'is-featured': item.destaque }]}>
                  <div class="testimonial-header">
                    <div class="testimonial-stars" aria-label={`${item.estrelas} de 5 estrelas`}>
                      {Array.from({ length: item.estrelas }).map(() => (
                        <span class="star-filled">★</span>
                      ))}
                    </div>
                    <span class="testimonial-cat-badge">{item.categoria}</span>
                  </div>
                  <blockquote class="testimonial-text">
                    “{item.texto}”
                  </blockquote>
                  <div class="testimonial-footer">
                    <span class="testimonial-author">{item.nomePublico}</span>
                    <span class="testimonial-badge-role">Participante FGF 2026</span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ) : (
          <div class="testimonials-empty-card">
            <div class="empty-icon">💬</div>
            <h3>Seja o primeiro a deixar seu depoimento!</h3>
            <p>Os feedbacks autorizados pela comunidade serão exibidos aqui após moderação da equipe.</p>
            <a href="#feedback" class="button button-yellow button-small">Deixar meu feedback agora ★</a>
          </div>
        )}
      </div>
    </section>

    <!-- Seção FGF Snap Pós-Evento ("O FGF SNAP SEGUE ATIVO") -->
    <section class="section snap-showcase-section" id="snaps" aria-labelledby="snaps-title">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow eyebrow-yellow">EXPERIÊNCIA INTERATIVA · CONTINUA DISPONÍVEL</p>
          <h2 id="snaps-title" style="color: #ffffff !important;">O FGF SNAP SEGUE ATIVO PARA VOCÊ</h2>
          <p class="section-desc" style="max-width: 680px; margin: 0 auto; color: rgba(255, 255, 255, 0.75);">
            A edição de 2026 terminou, mas o estúdio e as ativações oficiais do Family Game Festival continuam no ar!
            Crie fotos personalizadas, traga o mascote em 3D para sua sala e compartilhe suas figurinhas no WhatsApp.
          </p>
        </div>

        <div class="snap-cards-grid">
          <!-- Card 1: Criar Sua Foto -->
          <article class="snap-card snap-card-yellow">
            <div class="snap-card-header">
              <span class="snap-card-num">01</span>
              <span class="snap-card-badge">FOTOS & MOLDURAS</span>
            </div>
            <div class="snap-card-body">
              <h3>CRIAR SUA FOTO</h3>
              <p>
                Escolha entre molduras oficiais (Feed e Stories), adicione adesivos retrô e poses do Mascote para guardar e postar nas redes.
              </p>
            </div>
            <div class="snap-card-footer">
              <a class="button button-yellow button-small snap-card-btn" href="/snap/foto">
                <span>Abrir Estúdio de Fotos</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>

          <!-- Card 2: Mascote em Realidade Aumentada -->
          <article class="snap-card snap-card-cyan">
            <div class="snap-card-header">
              <span class="snap-card-num">02</span>
              <span class="snap-card-badge">REALIDADE AUMENTADA</span>
            </div>
            <div class="snap-card-body">
              <h3>MASCOTE EM AR</h3>
              <p>
                Veja o Mascote 3D oficial do FGF no seu ambiente através da câmera do seu celular, tire fotos e interaja com ele onde estiver.
              </p>
            </div>
            <div class="snap-card-footer">
              <a class="button button-cyan button-small snap-card-btn" href="/snap/ar">
                <span>Ver Mascote em 3D / AR</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>

          <!-- Card 3: Figurinhas Oficiais -->
          <article class="snap-card snap-card-pink">
            <div class="snap-card-header">
              <span class="snap-card-num">03</span>
              <span class="snap-card-badge">WHATSAPP & CHAT</span>
            </div>
            <div class="snap-card-body">
              <h3>FIGURINHAS OFICIAIS</h3>
              <p>
                Baixe o pacote oficial com expressões, poses de vitória e reações clássicas do Mascote para animar seus grupos gamers.
              </p>
            </div>
            <div class="snap-card-footer">
              <a class="button button-pink button-small snap-card-btn" href="/snap/figurinhas">
                <span>Baixar Figurinhas</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        </div>

        <!-- Banner Horizontal PWA / App Completo -->
        <div class="snap-app-banner">
          <div class="snap-banner-mascot">
            <img src="/assets/mascots/icon-mascote.png" alt="Mascote FGF" width="72" height="72" loading="lazy" />
          </div>
          <div class="snap-banner-info">
            <strong>FGF SNAP PWA · APLICATIVO DIRETO NO NAVEGADOR</strong>
            <p>Você pode adicionar o FGF Snap à tela de início do seu celular para abrir e editar fotos quando quiser, mesmo sem instalar nada pela loja.</p>
          </div>
          <div class="snap-banner-actions">
            <a class="button button-yellow button-small" href="/snap">
              <span>ACESSAR O FGF SNAP COMPLETO</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Seção / CTA Instagram -->
    <section class="section instagram-section" aria-labelledby="instagram-section-title">
      <div class="container">
        <div class="instagram-card">
          <div class="instagram-content">
            <p class="eyebrow eyebrow-yellow">BASTIDORES E FOTOS</p>
            <h2 id="instagram-section-title">A ENERGIA DO FESTIVAL EM IMAGENS</h2>
            <p>
              Centenas de fotos e vídeos dos campeonatos, cosplays, Just Dance e encontros estão no perfil oficial.
              Siga e marque <strong class="text-cyan">@familygamex</strong> para aparecer nos nossos destaques!
            </p>
            <div class="instagram-actions">
              <a
                class="button button-yellow"
                href={event.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>VER FOTOS E VÍDEOS NO INSTAGRAM</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="instagram-visual" aria-hidden="true">
            <div class="insta-photo-mockup photo-1">
              <div class="insta-badge">FGF 26</div>
              <span>#FamilyGameFestival</span>
            </div>
            <div class="insta-photo-mockup photo-2">
              <div class="insta-badge">ARENA TAUSTE</div>
              <span>@familygamex</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Seção Newsletter / Comunidade VIP ("FIQUE POR DENTRO") -->
    <section class="section newsletter-section" id="newsletter" aria-labelledby="newsletter-title">
      <div class="container">
        <div class="newsletter-card">
          <div class="newsletter-content">
            <p class="eyebrow eyebrow-yellow">COMUNIDADE FGF · LISTA VIP & NOVIDADES</p>
            <h2 id="newsletter-title" style="color: #ffffff !important;">RECEBA AS NOVIDADES DO FGF EM PRIMEIRA MÃO</h2>
