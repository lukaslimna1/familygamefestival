---
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import AdminReviewControls from '../../../components/admin/AdminReviewControls.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  adminReviewStatusLabel,
  driveFileUrl,
  formatAdminDate,
  getAdminRegistrationDetails,
  whatsappUrl
} from '../../../lib/server/admin/data';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect('/admin/login');
if (admin.mustChangePassword) return Astro.redirect('/admin/account/password');

const registration = Astro.params.id ? await getAdminRegistrationDetails(Astro.params.id) : null;
if (!registration) return new Response('Inscrição não encontrada.', { status: 404 });

const statusLabel = (status: string) => ({ pending: 'Pendente', drive_pending: 'Pendente', synced: 'Sincronizada', failed: 'Falha', cancelled: 'Cancelada', uploaded: 'Enviada', received: 'Recebida', physical_pending: 'Entrega física pendente', rejected: 'Rejeitada' }[status] ?? status);
const fileLabel = (type: string) => ({ registration_sheet: 'Ficha de inscrição', guardian_authorization: 'Autorização do menor', guardian_authorization_signed: 'Autorização assinada', cosplay_reference: 'Referência', cosplay_audio: 'Áudio', kpop_audio: 'MP3 da apresentação' }[type] ?? type);
const whatsapp = whatsappUrl(registration.phone);
const reviewState = Astro.url.searchParams.get('review');
const needsAttention = registration.driveSyncStatus === 'failed'
  || registration.files.some((file) => file.syncStatus === 'failed')
  || (registration.isMinor && (!registration.minorAuthorization || !['uploaded', 'received'].includes(registration.minorAuthorization.status)))
  || (registration.competitionId === 'k-pop-individual' && !registration.files.some((file) => file.fileType === 'kpop_audio'));
---

<AdminLayout
  title="Detalhe da inscrição | Family Game Festival"
  subtitle={registration.publicCode ?? registration.fullName}
  admin={admin}
  action={{ label: 'Voltar para inscrições', href: '/admin/inscricoes' }}
  notificationCount={needsAttention ? 1 : 0}
>
  <div class="admin-v2-page">
    <div class="admin-v2-breadcrumb"><a href="/admin">Dashboard</a><span>/</span><a href="/admin/inscricoes">Inscrições</a><span>/</span><strong>{registration.publicCode ?? 'Detalhe'}</strong></div>
    {reviewState === '1' && <p class="admin-v2-feedback is-success">Status de conferência atualizado.</p>}
    {reviewState === 'error' && <p class="admin-v2-feedback is-error">Não foi possível atualizar o status de conferência.</p>}

    <section class="admin-v2-detail-hero">
      <div>
        <p class="admin-eyebrow">{registration.competitionCategory} · {registration.competitionTitle}</p>
        <h2>{registration.fullName}</h2>
        <p class="admin-v2-detail-code">{registration.publicCode ?? 'Código ainda não gerado'} · criada em {formatAdminDate(registration.registrationCreatedAt)}</p>
      </div>
      <div class="admin-v2-detail-hero-tags"><span class:list={['admin-v2-status', 'status-' + registration.reviewStatus]}>{adminReviewStatusLabel(registration.reviewStatus)}</span><span class:list={['admin-v2-age-badge', registration.isMinor ? 'is-minor' : 'is-adult']}>{registration.isMinor ? 'Menor de idade' : 'Maior de idade'} · {registration.age} anos</span></div>
    </section>

    <AdminReviewControls registrationId={registration.registrationId} status={registration.reviewStatus} returnTo={Astro.url.pathname} />

    <div class="admin-v2-detail-grid">
      <section class="admin-v2-card admin-v2-detail-main" aria-labelledby="participant-data-title">
        <div class="admin-v2-card-heading"><div><p class="admin-section-kicker">Cadastro · somente leitura</p><h2 id="participant-data-title">Dados do participante</h2><p>Os dados originais não podem ser alterados pela administração. O participante usa o código próprio para as atualizações permitidas.</p></div></div>
        <dl class="admin-v2-definition-list admin-v2-definition-list-large">
          <div><dt>Nome completo</dt><dd>{registration.fullName}</dd></div>
          <div><dt>CPF</dt><dd>{registration.cpf}</dd></div>
          <div><dt>Data de nascimento</dt><dd>{registration.dateOfBirth}</dd></div>
          <div><dt>Telefone</dt><dd>{registration.phone || '—'}</dd></div>
          <div><dt>WhatsApp</dt><dd>{whatsapp ? <a class="admin-v2-contact-link" href={whatsapp} target="_blank" rel="noreferrer"><AdminIcon name="whatsapp" /> Abrir conversa</a> : '—'}</dd></div>
          <div><dt>E-mail</dt><dd>{registration.email || '—'}</dd></div>
          <div><dt>Cidade / estado</dt><dd>{registration.city} · {registration.state}</dd></div>
          <div><dt>Instagram</dt><dd>{registration.instagram || '—'}</dd></div>
          <div><dt>TikTok</dt><dd>{registration.tiktok || '—'}</dd></div>
        </dl>
      </section>

      <aside class="admin-v2-detail-side">
        <section class="admin-v2-card" aria-labelledby="registration-meta-title">
          <div class="admin-v2-card-heading"><div><p class="admin-section-kicker">Contexto</p><h2 id="registration-meta-title">Inscrição</h2></div></div>
          <dl class="admin-v2-definition-list">
            <div><dt>Competição</dt><dd>{registration.competitionTitle}</dd></div>
            <div><dt>Data do evento</dt><dd>{registration.competitionEventDate} · {registration.competitionEventDay}</dd></div>
            <div><dt>Horário</dt><dd>{registration.competitionStartTime}</dd></div>
            <div><dt>Origem</dt><dd>{registration.source === 'online' ? 'Online' : registration.source}</dd></div>
            <div><dt>Conferência</dt><dd><span class:list={['admin-v2-status', 'status-' + registration.reviewStatus]}>{adminReviewStatusLabel(registration.reviewStatus)}</span></dd></div>
            <div><dt>Sincronização</dt><dd><span class:list={['admin-v2-status', 'status-' + registration.driveSyncStatus]}>{statusLabel(registration.driveSyncStatus)}</span></dd></div>
          </dl>
          {registration.driveLastError && <p class="admin-v2-error-note">{registration.driveLastError}</p>}
        </section>

        {registration.guardian && (
          <section class="admin-v2-card" aria-labelledby="guardian-title">
            <div class="admin-v2-card-heading"><div><p class="admin-section-kicker">Responsável legal</p><h2 id="guardian-title">{registration.guardian.fullName}</h2></div></div>
            <dl class="admin-v2-definition-list"><div><dt>Parentesco</dt><dd>{registration.guardian.relationship}</dd></div><div><dt>Telefone</dt><dd>{registration.guardian.phone}</dd></div><div><dt>E-mail</dt><dd>{registration.guardian.email}</dd></div><div><dt>Autorização</dt><dd>{registration.minorAuthorization ? statusLabel(registration.minorAuthorization.status) + ' · V' + registration.minorAuthorization.version : 'Não encontrada'}</dd></div></dl>
          </section>
        )}
        {registration.minorAuthorizationHistory.length > 0 && (
          <section class="admin-v2-card" aria-labelledby="authorization-history-title">
            <div class="admin-v2-card-heading"><div><p class="admin-section-kicker">Versionamento</p><h2 id="authorization-history-title">Histórico da autorização</h2></div></div>
            <div class="admin-v2-history-list">{registration.minorAuthorizationHistory.map((authorization) => <div class="admin-v2-history-row"><span class="admin-v2-version-badge">V{authorization.version}</span><span><strong>{statusLabel(authorization.status)}</strong><small>{authorization.competitionIds.length ? authorization.competitionIds.join(' · ') : 'Evento'}</small></span><span class="admin-v2-history-actions">{driveFileUrl(authorization.generatedFileId) && <a href={driveFileUrl(authorization.generatedFileId)!} target="_blank" rel="noreferrer">Gerada</a>}{driveFileUrl(authorization.signedDriveFileId) && <a href={driveFileUrl(authorization.signedDriveFileId)!} target="_blank" rel="noreferrer">Assinada</a>}</span></div>)}</div>
          </section>
        )}
      </aside>
    </div>

    <div class="admin-v2-detail-grid admin-v2-detail-grid-lower">
      {registration.kpop && (
        <section class="admin-v2-card" aria-labelledby="kpop-title">
          <div class="admin-v2-card-heading"><div><p class="admin-section-kicker">Dados da apresentação</p><h2 id="kpop-title">K-Pop Individual</h2><p>Informações específicas enviadas pelo participante.</p></div></div>
          <dl class="admin-v2-definition-list">
            <div><dt>Nome artístico</dt><dd>{registration.kpop.stageName || '—'}</dd></div>
            <div><dt>Artista / grupo original</dt><dd>{registration.kpop.originalArtist}</dd></div>
            <div><dt>Nome da música</dt><dd>{registration.kpop.songTitle}</dd></div>
            <div><dt>Versão</dt><dd>{registration.kpop.songVersion || '—'}</dd></div>
            <div><dt>Música editada ou cortada?</dt><dd>{registration.kpop.editedCut === 'yes' ? 'Sim' : 'Não'}</dd></div>
            <div><dt>Cópia em pendrive</dt><dd>{registration.kpop.pendriveAcknowledged ? 'Ciente' : 'Não confirmado'}</dd></div>
            <div><dt>Referência</dt><dd><a href={registration.kpop.referenceUrl} target="_blank" rel="noreferrer">Abrir coreografia / MV / vídeo <AdminIcon name="external" /></a></dd></div>
          </dl>
          {registration.kpop.audioNotes && <p class="admin-v2-error-note"><strong>Observações sobre o áudio:</strong> {registration.kpop.audioNotes}</p>}
          {registration.kpop.judgeNotes && <p class="admin-v2-error-note"><strong>Observações para os jurados:</strong> {registration.kpop.judgeNotes}</p>}
        </section>
      )}
      <section class="admin-v2-card" aria-labelledby="documents-title">
        <div class="admin-v2-card-heading"><div><p class="admin-section-kicker">Arquivos</p><h2 id="documents-title">Documentação e Drive</h2><p>O Drive é a origem secundária; a situação operacional vem do banco.</p></div></div>
        {registration.files.length ? <div class="admin-v2-file-list">{registration.files.map((file) => <div class="admin-v2-file-row"><span class="admin-v2-file-icon"><AdminIcon name={file.fileType === 'cosplay_audio' || file.fileType === 'kpop_audio' ? 'spark' : 'folder'} /></span><span><strong>{fileLabel(file.fileType)}</strong><small>{file.originalName} · {(file.sizeBytes / 1024).toFixed(0)} KB · {statusLabel(file.syncStatus)}</small></span><span class="admin-v2-file-actions">{file.driveFileId && <a href={`/api/admin/files/${file.id}`} target="_blank" rel="noreferrer" class="admin-v2-icon-link is-open" aria-label={'Abrir ' + fileLabel(file.fileType)} title="Abrir arquivo"><AdminIcon name="external" /></a>}{file.driveFileId && <a href={`/api/admin/files/${file.id}?download=1`} download class="admin-v2-icon-link is-download" aria-label={'Baixar ' + fileLabel(file.fileType)} title="Baixar arquivo"><AdminIcon name="download" /></a>}</span></div>)}</div> : <div class="admin-v2-inline-empty">Nenhum arquivo registrado para esta inscrição.</div>}
      </section>

      <section class="admin-v2-card" aria-labelledby="consents-title">
        <div class="admin-v2-card-heading"><div><p class="admin-section-kicker">Conformidade</p><h2 id="consents-title">Aceites</h2></div></div>
        {registration.consents.length ? <div class="admin-v2-consent-list">{registration.consents.map((consent) => <div><span class="admin-v2-check">✓</span><span><strong>{consent.type}</strong><small>Versão {consent.policyVersion} · {formatAdminDate(consent.grantedAt)}</small></span></div>)}</div> : <div class="admin-v2-inline-empty">Nenhum aceite registrado.</div>}
        {registration.links.length > 0 && <div class="admin-v2-links-block"><strong>Links enviados</strong>{registration.links.map((link) => <a href={link.url} target="_blank" rel="noreferrer">{link.label} <AdminIcon name="external" /></a>)}</div>}
      </section>
    </div>
  </div>
</AdminLayout>
