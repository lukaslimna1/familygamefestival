---
import BaseLayout from '../layouts/BaseLayout.astro';
import { event, navItems, guests, attractions, tournaments, tournamentGroups, gameArt, experiences, tickets, competitorTickets, partners } from '../data/event';

const getTournamentArt = (tournament: (typeof tournaments)[number]) => gameArt.find((game) => tournament.title.includes(game.title)) ?? gameArt[0];
const initialTournament = tournaments[0];
const featuredEntries = tournaments.filter((tournament) => tournament.featured).map((tournament) => ({ tournament, art: getTournamentArt(tournament) }));
const groupedEntries = tournamentGroups.map((group) => ({ ...group, entries: group.ids.map((id) => {
  const tournament = tournaments.find((item) => item.id === id)!;
  return { tournament, art: getTournamentArt(tournament) };
}) }));
const initialArt = getTournamentArt(initialTournament);
---

<BaseLayout>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#inicio" aria-label="Family Game Festival · início">
        <img src="/assets/logo.svg" alt="Family Game Festival" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span>
        <span class="sr-only">Abrir menu</span>
      </button>
      <nav class="main-nav" id="main-nav" aria-label="Navegação principal">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button button-small button-yellow nav-cta" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar ingresso <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>

  <section class="event-spotlight" aria-labelledby="event-spotlight-title">
    <div class="container">
      <div class="event-spotlight-shell">
        <div class="event-spotlight-main">
          <div class="event-spotlight-heading">
            <p class="eyebrow eyebrow-yellow">Evento confirmado · Bauru/SP</p>
            <h2 id="event-spotlight-title">O festival está chegando.</h2>
          </div>
          <div class="event-spotlight-facts" aria-label="Data, local e horário do evento">
            <div class="event-spotlight-fact"><span>DATA</span><strong>19 e 20</strong><small>SETEMBRO DE 2026</small></div>
            <div class="event-spotlight-fact"><span>LOCAL</span><strong>SORRI</strong><small>BAURU · ARENA TAUSTE</small></div>
            <div class="event-spotlight-fact"><span>HORÁRIO</span><strong>{event.hours}</strong><small>HORÁRIO DO EVENTO</small></div>
          </div>
        </div>

        <div class="event-countdown" data-countdown data-countdown-target="2026-09-19T11:00:00-03:00" role="timer" aria-label="Contagem regressiva para o início do Family Game Festival">
          <div class="event-countdown-heading"><span>CONTAGEM REGRESSIVA</span><strong data-countdown-status>PARA O FESTIVAL</strong></div>
          <div class="event-countdown-grid">
            <div><strong data-countdown-days>00</strong><span>dias</span></div>
            <div><strong data-countdown-hours>00</strong><span>horas</span></div>
            <div><strong data-countdown-minutes>00</strong><span>min</span></div>
            <div><strong data-countdown-seconds>00</strong><span>seg</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main>
    <section class="hero" id="inicio">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> 1ª edição · Bauru, SP</p>
          <h1>O encontro onde <em>todo mundo joga.</em></h1>
          <p class="hero-lead">Do controle clássico ao palco geek: dois dias de campeonatos, dança, cosplay, dublagem e experiências para jogar junto.</p>
          <div class="hero-actions">
            <a class="button button-yellow" href={event.ticketUrl} target="_blank" rel="noreferrer">Garantir meu ingresso <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#campeonatos">Ver campeonatos <span aria-hidden="true">↓</span></a>
          </div>
          <div class="event-facts" aria-label="Informações principais do evento">
            <div><strong>19—20</strong><span>setembro de 2026</span></div>
            <div><strong>SORRI</strong><span>Bauru · Arena Tauste</span></div>
            <div><strong>{event.hours}</strong><span>horário do evento</span></div>
          </div>
        </div>

        <div class="hero-stage" aria-label="Identidade visual do Family Game Festival">
          <div class="stage-topline"><span>FAMILY GAME FESTIVAL</span><span>FGF / 26</span></div>
          <div class="stage-art">
            <img class="stage-grid" src="/assets/svg/grid.svg" alt="" aria-hidden="true" />
            <img class="stage-lines" src="/assets/svg/interface-lines.svg" alt="" aria-hidden="true" />
            <span class="stage-label stage-label-top">GAME · GEEK · CULTURE</span>
            <img class="stage-logo" src="/assets/logo.svg" alt="Family Game Festival 2026" />
            <img class="stage-mascot" src="/assets/mascot-original.png" alt="Mascote do Family Game Festival" />
            <span class="stage-chip chip-cyan">PLAY</span>
            <span class="stage-chip chip-pink">LEVEL 01</span>
            <span class="stage-label stage-label-bottom">19—20 SET · BAURU/SP</span>
          </div>
          <div class="stage-bottomline"><span>ARENA TAUSTE</span><span class="stage-stars">✦ ✦ ✦</span></div>
        </div>
      </div>
    </section>

    <section class="section section-dark intro-section">
      <div class="container intro-grid">
        <div>
          <p class="eyebrow eyebrow-cyan">O festival</p>
          <h2>Uma arena para quem joga, dança, cria e compartilha.</h2>
        </div>
        <div class="intro-copy">
          <p>{event.experienceLine}</p>
          <p>{event.socialImpact} É um festival de games e cultura geek com impacto social associado.</p>
          <a class="text-link text-link-light" href={event.instagramUrl} target="_blank" rel="noreferrer">Acompanhar no Instagram <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="section section-light" id="atracoes">
      <div class="container">
        <div class="section-heading heading-row">
          <div><p class="eyebrow eyebrow-red">O que te espera</p><h2>Escolha seu modo de jogar.</h2></div>
          <p class="heading-note">Experiências para quem compete, assiste, coleciona ou só quer passar um dia diferente com a família.</p>
        </div>

        <div class="attraction-grid">
          {attractions.map((item, index) => (
            <article class={`attraction-card accent-${item.accent}`}>
              <div class="card-index">0{index + 1}</div>
              <img src={`/assets/svg/${item.icon}`} alt="" aria-hidden="true" />
              <p class="card-eyebrow">{item.eyebrow}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <div class="section-heading guest-heading">
          <div><p class="eyebrow eyebrow-pink">Presenças confirmadas</p><h2>Gente que transforma a arena.</h2></div>
        </div>
        <div class="guest-grid">
          {guests.map((guest) => (
            <article class={`guest-card guest-${guest.accent}`}>
              <div class="guest-art">
                <span class="guest-art-label">ATRAÇÃO CONFIRMADA</span>
                <img src={guest.image} alt="" aria-hidden="true" />
                <span class="guest-art-number">FGF 26</span>
              </div>
              <div class="guest-content">
                <p class="card-eyebrow">{guest.role}</p>
                <h3>{guest.name}</h3>
                <p>{guest.description}</p>
                <p class="guest-highlight">{guest.highlight}</p>
                <a class="text-link" href={guest.instagramUrl} target="_blank" rel="noreferrer">{guest.handle} <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-navy tournaments-section" id="campeonatos">
      <div class="container">
        <div class="section-heading heading-row">
          <div><p class="eyebrow eyebrow-yellow">Programação competitiva</p><h2>Escolha seu campeonato.</h2></div>
          <p class="heading-note heading-note-light">Cosplay e Just Dance ganham o destaque do palco. Passe o mouse — ou use Tab — nos cards para trocar a imagem e os detalhes ao lado.</p>
        </div>

        <div class="tournament-showcase" data-tournament-showcase>
          <article class={`tournament-preview preview-${initialTournament.accent}`}>
            <div class="tournament-preview-media" style={`--art-image: url("${initialArt.image}")`}>
              <img class={`tournament-preview-image preview-fit-${initialArt.fit}`} src={initialArt.image} alt={initialArt.alt} data-preview-image loading="eager" />
              <div class="tournament-preview-overlay"></div>
              <span class="preview-overline">DESTAQUE EM FOCO</span>
              <span class="preview-corner">FGF / 26</span>
              <span class="preview-arrow" aria-hidden="true">↗</span>
            </div>
            <div class="tournament-preview-content">
              <p class="card-eyebrow" data-preview-category>{initialTournament.category}</p>
              <h3 data-preview-title>{initialTournament.title}</h3>
              <p class="preview-detail" data-preview-detail>{initialTournament.detail}</p>
              <div class="preview-facts">
                <div class="preview-fact"><span>DATA</span><strong data-preview-date>{initialTournament.date}</strong></div>
                <div class="preview-fact" data-preview-time-fact hidden={!initialTournament.time}><span>HORÁRIO</span><strong data-preview-time>{initialTournament.time || '—'}</strong></div>
                <div class="preview-fact"><span>PREMIAÇÃO</span><strong data-preview-prize>{initialTournament.prize}</strong></div>
              </div>
            </div>
          </article>

          <div class="competition-directory">
            <div class="competition-group competition-special-group">
              <div class="competition-group-heading">
                <div><p class="card-eyebrow">Destaques do palco</p><h3>Cosplay e dança</h3></div>
                <span>2 atrações</span>
              </div>
              <div class="special-competition-grid">
                {featuredEntries.map((entry, index) => (
                  <button
                    class={`competition-card competition-card-featured competition-card-${entry.tournament.accent} ${index === 0 ? 'is-active' : ''}`}
                    type="button"
                    data-tournament-card
                    data-title={entry.tournament.title}
                    data-category={entry.tournament.category}
                    data-date={entry.tournament.date}
                    data-time={entry.tournament.time}
                    data-prize={entry.tournament.prize}
                    data-detail={entry.tournament.detail}
                    data-image={entry.art.image}
                    data-alt={entry.art.alt}
                    data-fit={entry.art.fit}
                    data-accent={entry.tournament.accent}
                    aria-label={`Ver detalhes de ${entry.tournament.title}`}
                  >
                    <span class="competition-card-art" style={`--art-image: url("${entry.art.image}")`}><img class={`competition-art-fit-${entry.art.fit}`} src={entry.art.image} alt="" aria-hidden="true" loading="lazy" /></span>
                    <span class="competition-card-copy"><small>{entry.tournament.category}</small><strong>{entry.tournament.title}</strong><span>{entry.tournament.date}{entry.tournament.time ? ` · ${entry.tournament.time}` : ''}</span></span>
                    <span class="competition-card-prize"><small>PRÊMIO</small><strong>{entry.tournament.prize}</strong></span>
                  </button>
                ))}
              </div>
            </div>

            {groupedEntries.map((group) => (
              <div class={`competition-group competition-group-${group.accent}`}>
                <div class="competition-group-heading">
                  <div><p class="card-eyebrow">{group.kicker}</p><h3>{group.title}</h3></div>
                  <span>{group.entries.length} disputas</span>
                </div>
                <div class="competition-group-list">
                  {group.entries.map((entry, index) => (
                    <button
                      class={`competition-card competition-card-${entry.tournament.accent}`}
                      type="button"
                      data-tournament-card
                      data-title={entry.tournament.title}
                      data-category={entry.tournament.category}
                      data-date={entry.tournament.date}
                      data-time={entry.tournament.time}
                      data-prize={entry.tournament.prize}
                      data-detail={entry.tournament.detail}
                      data-image={entry.art.image}
                      data-alt={entry.art.alt}
                      data-fit={entry.art.fit}
                      data-accent={entry.tournament.accent}
                      aria-label={`Ver detalhes de ${entry.tournament.title}`}
                    >
                      <span class="competition-card-number">0{index + 1}</span>
                      <span class="competition-card-art" style={`--art-image: url("${entry.art.image}")`}><img class={`competition-art-fit-${entry.art.fit}`} src={entry.art.image} alt="" aria-hidden="true" loading="lazy" /></span>
                      <span class="competition-card-copy"><small>{entry.tournament.category}</small><strong>{entry.tournament.title}</strong><span>{entry.tournament.date}{entry.tournament.time ? ` · ${entry.tournament.time}` : ''}</span></span>
                      <span class="competition-card-prize"><small>PRÊMIO</small><strong>{entry.tournament.prize}</strong></span>
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section section-light experiences-section">
      <div class="container">
        <div class="section-heading"><p class="eyebrow eyebrow-cyan">Mais para viver</p><h2>O ingresso abre um mapa inteiro.</h2></div>
        <div class="experience-grid">
          {experiences.map((experience) => (
            <article class="experience-card">
              <span class="experience-number">{experience.number}</span>
              <img src={`/assets/svg/${experience.icon}`} alt="" aria-hidden="true" />
              <h3>{experience.title}</h3>
              <p>{experience.text}</p>
            </article>
          ))}
        </div>
        <div class="inclusive-note"><img src="/assets/svg/controller.svg" alt="" aria-hidden="true" /><p><strong>Todo mundo tem espaço na partida.</strong> O festival também prepara competições e experiências inclusivas para pessoas com deficiência. Formatos e detalhes serão divulgados conforme confirmação.</p></div>
      </div>
    </section>

    <section class="section section-dark tickets-section" id="ingressos">
      <div class="container">
        <div class="section-heading heading-row">
          <div><p class="eyebrow eyebrow-yellow">Escolha seu passe</p><h2>Seu próximo fim de semana começa aqui.</h2></div>
          <p class="heading-note heading-note-light">Os valores abaixo não incluem a taxa da plataforma. Garanta seu ingresso na bilheteria oficial.</p>
        </div>
        <div class="ticket-grid">
          {tickets.map((ticket) => (
            <article class={`ticket-card ticket-${ticket.accent}`}>
              <div class="ticket-card-top"><p>{ticket.name}</p><span aria-hidden="true">✦</span></div>
              <strong>{ticket.price}</strong>
              <small>{ticket.fee}</small>
              <h3>{ticket.detail}</h3>
              <p>{ticket.note}</p>
              <a class="text-link text-link-light" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar este ingresso <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>

        <div class="vip-highlight">
          <div class="vip-diamond" aria-hidden="true">VIP<br /><span>◆</span></div>
          <div class="vip-copy"><p class="eyebrow eyebrow-yellow">Edição limitada</p><h3>VIP Diamante Family Game</h3><p>Somente 100 unidades.</p><div class="vip-price"><strong>R$ 100,00</strong><span>+ R$ 8,50 de taxa</span></div></div>
          <ul class="vip-benefits">
            <li><strong>2 dias</strong> de festival</li>
            <li><strong>1 hora antes</strong> da abertura oficial</li>
            <li><strong>Entrada prioritária</strong> e credencial VIP exclusiva</li>
            <li><strong>3 brindes</strong> exclusivos Family Game</li>
          </ul>
          <p class="vip-warning">Não inclui inscrição nos campeonatos.</p>
          <a class="button button-yellow" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar VIP <span aria-hidden="true">↗</span></a>
        </div>

        <div class="competitor-tickets">
          <div class="competitor-heading">
            <div><p class="eyebrow eyebrow-pink">Inscrições competitivas</p><h3>Ingressos de competidor.</h3></div>
            <p>Uma inscrição específica para entrar na disputa. Cada card já traz data, horário, taxa, parcelamento e premiação.</p>
          </div>
          <div class="competitor-ticket-grid">
            {competitorTickets.map((ticket) => (
              <article class={`competitor-ticket-card ticket-${ticket.accent}`}>
                <div class="competitor-ticket-top"><span class="competitor-ticket-icon" aria-hidden="true">{ticket.icon}</span><span class="competitor-ticket-label">COMPETIDOR</span></div>
                <h4>{ticket.name}</h4>
                <p class="competitor-ticket-schedule">{ticket.schedule}</p>
                <div class="competitor-ticket-price"><strong>{ticket.price}</strong><span>{ticket.fee}</span></div>
                <p class="competitor-ticket-installments">{ticket.installments}</p>
                <p class="competitor-ticket-prize"><span>PREMIAÇÃO</span>{ticket.prize}</p>
                <p class="competitor-ticket-note">{ticket.note}</p>
                <a class="text-link text-link-light" href={event.ticketUrl} target="_blank" rel="noreferrer">Inscrever-se <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        </div>

        <div class="ticket-footer"><p><strong>Quer jogar os dois dias?</strong> O VIP dá acesso completo ao festival, com entrada uma hora antes e benefícios exclusivos.</p><a class="button button-yellow" href={event.ticketUrl} target="_blank" rel="noreferrer">Garantir meu ingresso <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="section section-light partner-section" id="expositores">
      <div class="container split-section">
        <div class="split-copy"><p class="eyebrow eyebrow-red">Quem faz acontecer</p><h2>Marcas, criadores e apoios fazem parte da fase.</h2><p>O Family Game Festival conecta o público de Bauru a quem movimenta a cultura gamer e geek. Conheça quem já está confirmado.</p></div>
        <div class="partner-list">
          {partners.map((partner) => (
            <article class={`partner-card partner-${partner.accent}`}><span class="partner-mark">{partner.name.slice(0, 1)}</span><div><h3>{partner.name}</h3><p>{partner.status}</p><small>{partner.handle}</small></div>{partner.href ? <a href={partner.href} target="_blank" rel="noreferrer" aria-label={`Ver ${partner.name} no Instagram`}>↗</a> : <span class="partner-pending">apoio</span>}</article>
          ))}
          <div class="partner-footnote"><img src="/assets/svg/chevrons.svg" alt="" aria-hidden="true" /><p>Há espaço para mais histórias, produtos e experiências.</p></div>
        </div>
      </div>
      <div class="container exhibitor-cta"><div><p class="eyebrow eyebrow-cyan">Expositores & marcas</p><h2>Leve sua marca para dentro do jogo.</h2><p>Serão três espaços para expositores além da Edge 3D Studio. Para participar ou patrocinar o festival, fale diretamente com o Juruna.</p></div><div class="exhibitor-actions"><a class="button button-red" href={event.whatsapp.exhibitors} target="_blank" rel="noreferrer">Quero ser expositor <span aria-hidden="true">↗</span></a><a class="button button-outline-dark" href={event.whatsapp.sponsors} target="_blank" rel="noreferrer">Quero ser patrocinador <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section class="section contact-section" id="contato">
      <div class="container contact-grid">
        <div><p class="eyebrow eyebrow-pink">Fale com a organização</p><h2>Vamos colocar sua ideia em jogo?</h2><p>Para ingressos, expositores, patrocínio, imprensa e outras dúvidas, envie uma mensagem pelas redes oficiais do evento.</p><a class="button button-yellow" href={event.instagramUrl} target="_blank" rel="noreferrer">Chamar no Instagram <span aria-hidden="true">↗</span></a></div>
        <div class="location-card"><div class="location-icon"><img src="/assets/svg/cursor.svg" alt="" aria-hidden="true" /></div><p class="card-eyebrow">Onde acontece</p><h3>{event.venue}</h3><p>{event.address}</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=SORRI+Bauru+Arena+Tauste" target="_blank" rel="noreferrer">Abrir no mapa <span aria-hidden="true">↗</span></a><div class="location-tags"><span>19/09 · sábado</span><span>20/09 · domingo</span><span>{event.hours}</span></div></div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-top"><a class="brand" href="#inicio"><img src="/assets/logo.svg" alt="Family Game Festival" /></a><p>Games, cultura geek e impacto local.<br />Bauru · 19—20 setembro 2026</p><a class="button button-yellow button-small" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar ingresso <span aria-hidden="true">↗</span></a></div>
    <div class="container footer-bottom"><span>© 2026 Family Game Festival</span><a href={event.instagramUrl} target="_blank" rel="noreferrer">{event.instagram}</a><span>Parte da arrecadação será revertida para a SORRI Bauru.</span></div>
  </footer>

  <script>
    const header = document.querySelector('.site-header');
    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelectorAll('.main-nav a');

    menuToggle?.addEventListener('click', () => {
      const open = header?.classList.toggle('menu-open') ?? false;
      menuToggle.setAttribute('aria-expanded', String(open));
    });

    navLinks.forEach((link) => link.addEventListener('click', () => {
      header?.classList.remove('menu-open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }));

    const tournamentShowcase = document.querySelector('[data-tournament-showcase]');
    const tournamentPreview = tournamentShowcase?.querySelector('.tournament-preview');
    const previewImage = tournamentShowcase?.querySelector('[data-preview-image]');
    const previewMedia = tournamentShowcase?.querySelector('.tournament-preview-media');
    const previewCategory = tournamentShowcase?.querySelector('[data-preview-category]');
    const previewTitle = tournamentShowcase?.querySelector('[data-preview-title]');
    const previewDetail = tournamentShowcase?.querySelector('[data-preview-detail]');
    const previewDate = tournamentShowcase?.querySelector('[data-preview-date]');
    const previewTime = tournamentShowcase?.querySelector('[data-preview-time]');
    const previewTimeFact = tournamentShowcase?.querySelector('[data-preview-time-fact]');
    const previewPrize = tournamentShowcase?.querySelector('[data-preview-prize]');
    const tournamentCards = tournamentShowcase?.querySelectorAll('[data-tournament-card]') ?? [];

    const setTournamentPreview = (card) => {
      const data = card.dataset;
      if (!data.title || !data.image || !previewImage || !previewMedia || !tournamentPreview) return;

      tournamentCards.forEach((item) => item.classList.remove('is-active'));
      card.classList.add('is-active');
      previewImage.className = `tournament-preview-image preview-fit-${data.fit || 'cover'}`;
      previewImage.setAttribute('src', data.image);
      previewImage.setAttribute('alt', data.alt || '');
      previewMedia.style.setProperty('--art-image', `url("${data.image}")`);
      previewCategory.textContent = data.category || '';
      previewTitle.textContent = data.title;
      previewDetail.textContent = data.detail || '';
      previewDate.textContent = data.date || '';
      previewTime.textContent = data.time || '—';
      previewTimeFact.hidden = !data.time;
      previewPrize.textContent = data.prize || '—';
      tournamentPreview.className = `tournament-preview preview-${data.accent || 'yellow'}`;
    };

    tournamentCards.forEach((card) => {
      card.addEventListener('mouseenter', () => setTournamentPreview(card));
      card.addEventListener('focus', () => setTournamentPreview(card));
      card.addEventListener('click', () => setTournamentPreview(card));
    });

    const countdown = document.querySelector('[data-countdown]');
    const countdownTarget = countdown?.getAttribute('data-countdown-target');
    const countdownStatus = countdown?.querySelector('[data-countdown-status]');
    const countdownDays = countdown?.querySelector('[data-countdown-days]');
    const countdownHours = countdown?.querySelector('[data-countdown-hours]');
    const countdownMinutes = countdown?.querySelector('[data-countdown-minutes]');
    const countdownSeconds = countdown?.querySelector('[data-countdown-seconds]');

    if (countdown && countdownTarget && countdownDays && countdownHours && countdownMinutes && countdownSeconds) {
      const targetTimestamp = new Date(countdownTarget).getTime();

      const updateCountdown = () => {
        const remaining = Math.max(targetTimestamp - Date.now(), 0);
        const totalSeconds = Math.floor(remaining / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        const format = (value) => String(value).padStart(2, '0');

        countdownDays.textContent = format(days);
        countdownHours.textContent = format(hours);
        countdownMinutes.textContent = format(minutes);
        countdownSeconds.textContent = format(seconds);

        if (remaining === 0 && countdownStatus) countdownStatus.textContent = 'O FESTIVAL COMEÇOU';
      };

      updateCountdown();
      const countdownTimer = window.setInterval(updateCountdown, 1000);
      window.addEventListener('pagehide', () => window.clearInterval(countdownTimer), { once: true });
    }
  </script>
</BaseLayout>
