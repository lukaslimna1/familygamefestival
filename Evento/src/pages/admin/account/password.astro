---
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect('/admin/login');
const firstAccess = admin.mustChangePassword;

const error = Astro.url.searchParams.get('error');
const message = error === 'current'
  ? 'A senha atual está incorreta.'
  : error === 'weak'
    ? 'A nova senha deve ter entre 12 e 256 caracteres.'
    : error === 'mismatch'
      ? 'A confirmação não corresponde à nova senha.'
      : error === 'unavailable'
        ? 'Não foi possível alterar a senha agora. Tente novamente.'
        : '';
---

<AdminLayout
  title="Trocar senha | Family Game Festival"
  subtitle={firstAccess ? 'Defina uma senha nova para liberar o painel administrativo.' : 'Atualize as credenciais de acesso à sua conta.'}
  admin={admin}
  action={!firstAccess ? { label: 'Voltar ao painel', href: '/admin' } : undefined}
>
  <div class="admin-security-page">
    <div class="admin-security-grid">
      <section class="admin-panel admin-password-panel" aria-labelledby="password-title">
        <div class="admin-password-intro">
          <span class:list={['admin-panel-badge', firstAccess ? 'admin-panel-badge-warning' : 'admin-panel-badge-neutral']}>
            {firstAccess ? 'Ação necessária' : 'Segurança da conta'}
          </span>
          <h2 id="password-title">{firstAccess ? 'Defina sua senha.' : 'Trocar senha.'}</h2>
          <p>
            {firstAccess
              ? 'Por segurança, defina uma nova senha antes de acessar qualquer outra área administrativa.'
              : 'Atualize a senha de acesso do painel quando precisar.'}
            {' '}Ao salvar, todas as sessões abertas serão encerradas.
          </p>
        </div>

        {firstAccess && (
          <p class="admin-message" role="status">Sua conta foi autenticada. Falta apenas concluir a troca obrigatória de senha.</p>
        )}
        {message && <p class="admin-message" role="alert">{message}</p>}

        <form method="post" action="/api/admin/account/password" class="admin-form">
          <input type="hidden" name="username" value={admin.username} autocomplete="username" />
          <div class="admin-form-field">
            <label for="currentPassword">
              Senha atual
              <span class="admin-form-hint">Obrigatório</span>
            </label>
            <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required maxlength="256" />
          </div>

          <div class="admin-form-field">
            <label for="newPassword">
              Nova senha
              <span class="admin-form-hint">Mínimo de 12 caracteres</span>
            </label>
            <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="256" />
          </div>

          <div class="admin-form-field">
            <label for="confirmation">Confirmar nova senha</label>
            <input id="confirmation" name="confirmation" type="password" autocomplete="new-password" required minlength="12" maxlength="256" />
          </div>

          <div class="admin-form-actions">
            <button class="admin-button admin-button-primary" type="submit">
              Salvar nova senha
              <AdminIcon name="arrow" />
            </button>
          </div>
        </form>

        <div class="admin-form-secondary-actions">
          {firstAccess ? (
            <form method="post" action="/api/admin/logout" class="admin-logout-form">
              <button class="admin-button admin-button-danger" type="submit">Sair da conta</button>
            </form>
          ) : (
            <div class="admin-navigation">
              <a class="admin-button admin-button-secondary" href="/admin">Cancelar</a>
              <a class="admin-back-link" href="/admin">Voltar ao painel</a>
            </div>
          )}
        </div>
      </section>

      <aside class="admin-security-aside" aria-labelledby="security-aside-title">
        <div class="admin-security-aside-header">
          <span class="admin-nav-icon"><AdminIcon name="lock" /></span>
          <h2 id="security-aside-title">Acesso protegido</h2>
        </div>
        <p>{firstAccess ? 'A troca libera o acesso ao painel e encerra qualquer sessão anterior desta conta.' : 'Mantenha uma senha forte e exclusiva para a operação do festival.'}</p>
        <ul class="admin-check-list">
          <li class="admin-check-item"><span class="admin-check-mark">✓</span><span>Use pelo menos 12 caracteres.</span></li>
          <li class="admin-check-item"><span class="admin-check-mark">✓</span><span>Combine palavras, números e símbolos.</span></li>
          <li class="admin-check-item"><span class="admin-check-mark">✓</span><span>Não compartilhe sua senha de administrador.</span></li>
        </ul>
        <p class="admin-security-note">Usuário conectado: <strong>{admin.username}</strong></p>
      </aside>
    </div>
  </div>
</AdminLayout>
