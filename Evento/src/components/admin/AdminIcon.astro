---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

{name === 'grid' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="4" y="4" width="6" height="6" rx="1" />
    <rect x="14" y="4" width="6" height="6" rx="1" />
    <rect x="4" y="14" width="6" height="6" rx="1" />
    <rect x="14" y="14" width="6" height="6" rx="1" />
  </svg>
)}
{name === 'clipboard' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="6" y="5" width="12" height="15" rx="2" />
    <path d="M9 5.25V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.25M9 10h6M9 14h6M9 17h3" />
  </svg>
)}
{name === 'spark' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="m12 2 1.55 6.45L20 10l-6.45 1.55L12 18l-1.55-6.45L4 10l6.45-1.55L12 2Z" />
    <path d="m19 16 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z" />
  </svg>
)}
{name === 'shield' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 3 19 6v5.3c0 4.4-2.8 7.6-7 9.7-4.2-2.1-7-5.3-7-9.7V6l7-3Z" />
    <path d="m9 12 2 2 4-4" />
  </svg>
)}
{name === 'folder' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M3.5 6.5h6l1.6 2h9.4v9.75a2.25 2.25 0 0 1-2.25 2.25H5.75a2.25 2.25 0 0 1-2.25-2.25V6.5Z" />
    <path d="M3.5 8.5h17" />
  </svg>
)}
{name === 'settings' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" />
    <path d="m19.4 13.5.05-1.5-.05-1.5 1.7-1.25-1.8-3.1-2 .75a7.3 7.3 0 0 0-2.6-1.5L14.4 3h-3.6l-.3 2.4a7.3 7.3 0 0 0-2.6 1.5l-2-.75-1.8 3.1 1.7 1.25L5.75 12l.05 1.5-1.7 1.25 1.8 3.1 2-.75a7.3 7.3 0 0 0 2.6 1.5l.3 2.4h3.6l.3-2.4a7.3 7.3 0 0 0 2.6-1.5l2 .75 1.8-3.1-1.7-1.25Z" />
  </svg>
)}
{name === 'lock' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="5" y="10" width="14" height="11" rx="2" />
    <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
  </svg>
)}
{name === 'logout' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M14 4H6.75A1.75 1.75 0 0 0 5 5.75v12.5A1.75 1.75 0 0 0 6.75 20H14" />
    <path d="M13 12h7M17 8l4 4-4 4" />
  </svg>
)}
{name === 'arrow' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M5 12h13M13 6l6 6-6 6" />
  </svg>
)}
{name === 'download' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 3v11M7.5 10.5 12 15l4.5-4.5M5 20h14" />
  </svg>
)}
{name === 'external' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M14 5h5v5M19 5l-8 8" />
    <path d="M18 13v4.25A1.75 1.75 0 0 1 16.25 19H6.75A1.75 1.75 0 0 1 5 17.25v-9.5A1.75 1.75 0 0 1 6.75 6H11" />
  </svg>
)}
{name === 'menu' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M4 7h16M4 12h16M4 17h16" />
  </svg>
)}
{name === 'search' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="10.8" cy="10.8" r="6.2" />
    <path d="m16 16 4.5 4.5" />
  </svg>
)}
