---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

{name === 'grid' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="4" y="4" width="6" height="6" rx="1" />
    <rect x="14" y="4" width="6" height="6" rx="1" />
    <rect x="4" y="14" width="6" height="6" rx="1" />
    <rect x="14" y="14" width="6" height="6" rx="1" />
  </svg>
)}
{name === 'clipboard' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="6" y="5" width="12" height="15" rx="2" />
    <path d="M9 5.25V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.25M9 10h6M9 14h6M9 17h3" />
  </svg>
)}
{name === 'spark' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="m12 2 1.55 6.45L20 10l-6.45 1.55L12 18l-1.55-6.45L4 10l6.45-1.55L12 2Z" />
    <path d="m19 16 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z" />
  </svg>
)}
{name === 'music' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M9 18V5l10-2v13" />
    <path d="M9 18a3 3 0 1 1-3-3 3 3 0 0 1 3 3Zm10-2a3 3 0 1 1-3-3 3 3 0 0 1 3 3Z" />
  </svg>
)}
{name === 'shield' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 3 19 6v5.3c0 4.4-2.8 7.6-7 9.7-4.2-2.1-7-5.3-7-9.7V6l7-3Z" />
    <path d="m9 12 2 2 4-4" />
  </svg>
)}
{name === 'folder' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M3.5 6.5h6l1.6 2h9.4v9.75a2.25 2.25 0 0 1-2.25 2.25H5.75a2.25 2.25 0 0 1-2.25-2.25V6.5Z" />
    <path d="M3.5 8.5h17" />
  </svg>
)}
{name === 'settings' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" />
    <path d="m19.4 13.5.05-1.5-.05-1.5 1.7-1.25-1.8-3.1-2 .75a7.3 7.3 0 0 0-2.6-1.5L14.4 3h-3.6l-.3 2.4a7.3 7.3 0 0 0-2.6 1.5l-2-.75-1.8 3.1 1.7 1.25L5.75 12l.05 1.5-1.7 1.25 1.8 3.1 2-.75a7.3 7.3 0 0 0 2.6 1.5l.3 2.4h3.6l.3-2.4a7.3 7.3 0 0 0 2.6-1.5l2 .75 1.8-3.1-1.7-1.25Z" />
  </svg>
)}
{name === 'lock' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="5" y="10" width="14" height="11" rx="2" />
    <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
  </svg>
)}
{name === 'logout' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M14 4H6.75A1.75 1.75 0 0 0 5 5.75v12.5A1.75 1.75 0 0 0 6.75 20H14" />
    <path d="M13 12h7M17 8l4 4-4 4" />
  </svg>
)}
{name === 'arrow' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M5 12h13M13 6l6 6-6 6" />
  </svg>
)}
{name === 'download' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 3v11M7.5 10.5 12 15l4.5-4.5M5 20h14" />
  </svg>
)}
{name === 'external' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M14 5h5v5M19 5l-8 8" />
    <path d="M18 13v4.25A1.75 1.75 0 0 1 16.25 19H6.75A1.75 1.75 0 0 1 5 17.25v-9.5A1.75 1.75 0 0 1 6.75 6H11" />
  </svg>
)}
{name === 'menu' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M4 7h16M4 12h16M4 17h16" />
  </svg>
)}
{name === 'search' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="10.8" cy="10.8" r="6.2" />
    <path d="m16 16 4.5 4.5" />
  </svg>
)}
{name === 'whatsapp' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M5.2 18.8 6.4 16A7.7 7.7 0 1 1 9 18.5l-3.8.3Z" />
    <path d="M9.2 9.2c.25 1.55 2.1 3.65 3.7 4.25l1.1-.85c.2-.16.46-.18.68-.06l1.3.7c.3.16.43.52.28.83-.32.67-.9 1.05-1.62 1.05-2.38 0-5.75-3.37-5.75-5.75 0-.72.38-1.3 1.05-1.62.31-.15.67-.02.83.28l.7 1.3c.12.22.1.48-.06.68l-.85 1.1Z" />
  </svg>
)}
{name === 'youtube' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20.2 7.3a2.4 2.4 0 0 0-1.7-1.7C17 5.2 12 5.2 12 5.2s-5 0-6.5.4a2.4 2.4 0 0 0-1.7 1.7C3.4 8.8 3.4 12 3.4 12s0 3.2.4 4.7a2.4 2.4 0 0 0 1.7 1.7c1.5.4 6.5.4 6.5.4s5 0 6.5-.4a2.4 2.4 0 0 0 1.7-1.7c.4-1.5.4-4.7.4-4.7s0-3.2-.4-4.7Z" />
    <path d="m10 9 5 3-5 3V9Z" />
  </svg>
)}
{name === 'chat' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'star' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'bulb' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'heart' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'copy' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'check' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <polyline points="20 6 9 17 4 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'filter' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'alert' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
    <line x1="12" y1="8" x2="12" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <line x1="12" y1="16" x2="12.01" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
)}
