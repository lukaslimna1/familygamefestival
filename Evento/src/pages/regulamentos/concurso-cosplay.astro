---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { event } from '../../data/event';
import { regulations } from '../../data/regulations';
import CosplayRegulationDocument from '../../components/CosplayRegulationDocument.astro';

export const prerender = true;

const regulation = regulations.cosplay;
const pdfUrl = `/assets/regulamentos/${encodeURIComponent(regulation.pdfFile)}`;
---

<BaseLayout
  title={`${regulation.title} | Family Game Festival`}
  description="Regulamento oficial do Concurso Cosplay do Family Game Festival 2026."
  canonical="https://familygamefestival.vercel.app/regulamentos/concurso-cosplay"
>
  <SiteHeader />

  <main class="regulation-page">
    <section class="regulation-hero">
      <div class="container regulation-hero-grid">
        <div>
          <p class="eyebrow eyebrow-cyan">Regulamento oficial · Cosplay</p>
          <h1>Concurso <em>Cosplay</em></h1>
          <p class="regulation-hero-subtitle">{regulation.subtitle}</p>
          <div class="regulation-hero-actions">
            <a class="button button-yellow" href={pdfUrl} download>Baixar PDF <span aria-hidden="true">↓</span></a>
            <button class="button button-outline-light" type="button" data-print>Imprimir / salvar <span aria-hidden="true">↗</span></button>
            <a class="text-link text-link-light" href="/#campeonatos">Voltar aos campeonatos <span aria-hidden="true">↩</span></a>
          </div>
        </div>
        <div class="regulation-hero-mark" aria-hidden="true">
          <span>FGF</span>
          <strong>26</strong>
          <small>ARENA TAUSTE<br />SORRI BAURU</small>
        </div>
      </div>
    </section>

    <section class="regulation-summary-section">
      <div class="container">
        <div class="regulation-summary-grid">
          <div><span>FORMATO</span><strong>Apresentação individual</strong></div>
          <div><span>VAGAS</span><strong>32 participantes</strong></div>
          <div><span>DATA</span><strong>20/09/2026 · 16h00</strong></div>
          <div><span>INSCRIÇÃO</span><strong>Presencial até 15h</strong></div>
          <div><span>TEMPO OFICIAL</span><strong>2m30</strong></div>
          <div><span>PREMIAÇÃO PRINCIPAL</span><strong>R$ 1.000,00</strong></div>
        </div>
      </div>
    </section>

    <section class="regulation-content-section">
      <CosplayRegulationDocument pdfUrl={pdfUrl} />
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-top"><a class="brand" href="/"><img src="/assets/logo.svg" alt="Family Game Festival" /></a><p>Games, cultura geek e impacto local.<br />Bauru · 19—20 setembro 2026</p><a class="button button-yellow button-small" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar ingresso <span aria-hidden="true">↗</span></a></div>
    <div class="container footer-bottom"><span>© 2026 Family Game Festival</span><a href={event.instagramUrl} target="_blank" rel="noreferrer">{event.instagram}</a><span>{event.socialImpact}</span><span class="footer-credit">Desenvolvido pela <a href="https://www.instagram.com/usealterstate/" target="_blank" rel="noreferrer">ALTERSTATE</a></span></div>
  </footer>

  <script>
    const header = document.querySelector('.site-header');
    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelectorAll('.main-nav a');
    menuToggle?.addEventListener('click', () => {
      const open = header?.classList.toggle('menu-open') ?? false;
      menuToggle.setAttribute('aria-expanded', String(open));
    });
    navLinks.forEach((link) => link.addEventListener('click', () => {
      header?.classList.remove('menu-open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }));
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
