        </div>
        <div class="sponsor-carousel-band media-support-carousel-band" aria-label="Parceiros de divulgação">
          <div class="sponsor-carousel-viewport">
            <div class="sponsor-carousel-track">
              {[...mediaPartners, ...mediaPartners].map((media, index) => {
                const duplicate = index >= mediaPartners.length;
                return (
                  <a class={`sponsor-carousel-item sponsor-carousel-${media.accent}`} href={media.href} target="_blank" rel="noreferrer" aria-label={`${media.name} · parceiro de divulgação`} title={`${media.name} · parceiro de divulgação`} aria-hidden={duplicate ? 'true' : undefined} tabindex={duplicate ? -1 : undefined}>
                    <span class="sponsor-carousel-logo"><img src={media.image} alt={`Logo ${media.name}`} loading="lazy" /></span>
                    <span class="sponsor-carousel-pill">Parceiro de divulgação</span>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
        <div class="press-kit-home-cta">
          <div><p class="eyebrow eyebrow-yellow">Kit de divulgação</p><h2>Quer apoiar o festival com a sua audiência?</h2><p>Abra o Press Kit para encontrar o serviço oficial, ângulos de pauta, textos prontos e os canais de contato.</p></div>
          <a class="button button-yellow" href="/press-kit">Abrir Press Kit <span aria-hidden="true">↗</span></a>
        </div>
