---
import { existsSync, readdirSync } from 'node:fs';
import { basename, extname, join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventSchedule from '../components/EventSchedule.astro';
import HomeCompetitionAccordion from '../components/HomeCompetitionAccordion.astro';
import SponsorHierarchy from '../components/SponsorHierarchy.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { event, guests, attractions, artistAlleyArtists, stores, mediaPartners, experiences, tickets, vipTickets, competitorTickets } from '../data/event';
import { competitionDays, getChampionshipEntry } from '../data/championships';
import { ONLINE_REGISTRATION_DEADLINE_LABEL, ONLINE_REGISTRATION_ONSITE_NOTICE } from '../config/registration-deadline';

export const prerender = true;

const homeCompetitionPanels = competitionDays.map((day) => {
  const entries = day.groups.flatMap((group) => group.entries);
  const featuredEntries = entries.filter((entry) => 'featured' in entry.tournament && entry.tournament.featured);
  const groupedEntries = day.groups
    .map((group) => ({ ...group, entries: group.entries.filter((entry) => !('featured' in entry.tournament && entry.tournament.featured)) }))
    .filter((group) => group.entries.length > 0);
  return { ...day, entries, featuredEntries, groupedEntries };
});

const competitorTicketEntries = competitorTickets.map((ticket) => {
  const entry = getChampionshipEntry(ticket.tournamentId)!;
  return { ...ticket, tournament: entry.tournament, schedule: entry.schedule, registrationFree: 'registrationFree' in entry.tournament && entry.tournament.registrationFree, eventAccessNote: entry.eventAccessNote };
});
const competitorTicketDays = [
  { day: 'SÁBADO', date: '19/09', slug: 'sabado' },
  { day: 'DOMINGO', date: '20/09', slug: 'domingo' }
].map((ticketDay) => ({
  ...ticketDay,
  entries: competitorTicketEntries.filter((entry) => entry.schedule.day === ticketDay.day)
}));
const guestVideoDirectory = join(process.cwd(), 'public/assets/videos');
const guestVideos = existsSync(guestVideoDirectory)
  ? readdirSync(guestVideoDirectory, { withFileTypes: true })
      .filter((entry) => entry.isFile() && /\.(mp4|webm|mov|m4v)$/i.test(entry.name))
      .sort((a, b) => a.name.localeCompare(b.name, 'pt-BR'))
      .map((entry) => {
        const extension = extname(entry.name).toLowerCase();
        const filenameTitle = basename(entry.name, extension).replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
        const guest = guests.find((item) => filenameTitle.toLowerCase().startsWith(item.name.split(' ')[0].toLowerCase()));
        return { filename: entry.name, title: guest?.name ?? filenameTitle, sourceType: extension === '.webm' ? 'video/webm' : extension === '.mov' ? 'video/quicktime' : 'video/mp4' };
      })
  : [];
---

<BaseLayout>
  <SiteHeader />

  <section class="event-spotlight" aria-labelledby="event-spotlight-title">
    <div class="container">
      <div class="event-spotlight-shell">
        <div class="event-spotlight-main">
          <div class="event-spotlight-heading">
            <p class="eyebrow eyebrow-yellow">Evento confirmado · Bauru/SP</p>
            <h2 id="event-spotlight-title">O festival está chegando.</h2>
          </div>
          <div class="event-spotlight-facts" aria-label="Data, local e horário do evento">
            <div class="event-spotlight-fact"><span>DATA</span><strong>19 e 20</strong><small>SETEMBRO DE 2026</small></div>
            <div class="event-spotlight-fact"><span>LOCAL</span><strong>SORRI</strong><small>BAURU · ARENA TAUSTE</small></div>
            <div class="event-spotlight-fact"><span>HORÁRIO</span><strong>{event.hours}</strong><small>HORÁRIO DO EVENTO</small></div>
          </div>
        </div>

        <div class="event-countdown" data-countdown data-countdown-target="2026-09-19T11:00:00-03:00" role="timer" aria-label="Contagem regressiva para o início do Family Game Festival">
          <div class="event-countdown-heading"><span>CONTAGEM REGRESSIVA</span><strong data-countdown-status>PARA O FESTIVAL</strong></div>
          <div class="event-countdown-grid">
            <div><strong data-countdown-days>00</strong><span>dias</span></div>
            <div><strong data-countdown-hours>00</strong><span>horas</span></div>
            <div><strong data-countdown-minutes>00</strong><span>min</span></div>
            <div><strong data-countdown-seconds>00</strong><span>seg</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main>
    <section class="hero" id="inicio">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> 1ª edição · Bauru, SP</p>
          <h1>O encontro onde <em>todo mundo joga.</em></h1>
          <p class="hero-lead">Do controle clássico ao palco geek: dois dias de campeonatos, dança, cosplay, dublagem e experiências para jogar junto.</p>
          <div class="hero-actions">
            <a class="button button-yellow" href={event.ticketUrl} target="_blank" rel="noreferrer">Garantir meu ingresso <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#campeonatos">Ver campeonatos <span aria-hidden="true">↓</span></a>
          </div>
          <div class="event-facts" aria-label="Informações principais do evento">
            <div><strong>19—20</strong><span>setembro de 2026</span></div>
            <div><strong>SORRI</strong><span>Bauru · Arena Tauste</span></div>
            <div><strong>{event.hours}</strong><span>horário do evento</span></div>
          </div>
        </div>

        <div class="hero-stage" aria-label="Identidade visual do Family Game Festival">
          <div class="stage-topline"><span>FAMILY GAME FESTIVAL</span><span>FGF / 26</span></div>
          <div class="stage-art">
            <img class="stage-grid" src="/assets/svg/grid.svg" alt="" aria-hidden="true" />
            <img class="stage-lines" src="/assets/svg/interface-lines.svg" alt="" aria-hidden="true" />
            <span class="stage-label stage-label-top">GAME · GEEK · CULTURE</span>
            <img class="stage-logo" src="/assets/logo.svg" alt="Family Game Festival 2026" />
            <img class="stage-mascot" src="/assets/mascots/0 - Pose Original.svg" alt="Mascote do Family Game Festival" />
            <span class="stage-chip chip-cyan">PLAY</span>
            <span class="stage-chip chip-pink">LEVEL 01</span>
            <span class="stage-label stage-label-bottom">19—20 SET · BAURU/SP</span>
          </div>
          <div class="stage-bottomline"><span>ARENA TAUSTE</span><span class="stage-stars">✦ ✦ ✦</span></div>
        </div>
      </div>
    </section>

    <EventSchedule />

    <section class="section section-dark intro-section">
      <div class="container intro-grid">
        <div>
          <p class="eyebrow eyebrow-cyan">O festival</p>
          <h2>Uma arena para quem joga, dança, cria e compartilha.</h2>
        </div>
        <div class="intro-copy">
          <p>{event.experienceLine}</p>
          <p>{event.socialImpact} É um festival de games e cultura geek com impacto social associado.</p>
          <a class="text-link text-link-light" href={event.instagramUrl} target="_blank" rel="noreferrer">Acompanhar no Instagram <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="section section-light attractions-section" id="atracoes">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-red">O que te espera</p><h2>Escolha seu modo de jogar.</h2></div>
          <p class="heading-note">Experiências para quem compete, assiste, coleciona ou só quer passar um dia diferente com a família.</p>
          <img class="section-mascot section-mascot-strength" src="/assets/mascots/2 - Pose Força.svg" alt="" aria-hidden="true" />
        </div>

        <div class="attraction-grid">
          {attractions.map((item, index) => (
            <article class={`attraction-card accent-${item.accent}`}>
              <div class="card-index">0{index + 1}</div>
              <img src={`/assets/svg/${item.icon}`} alt="" aria-hidden="true" />
              <p class="card-eyebrow">{item.eyebrow}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <div class="section-heading guest-heading" id="presencas-confirmadas">
          <div><p class="eyebrow eyebrow-pink">Presenças confirmadas</p><h2>Gente que transforma a arena.</h2></div>
        </div>
        <div class="guest-grid">
          {guests.map((guest) => (
            <article class={`guest-card guest-${guest.accent} guest-${guest.slug}`}>
              <div class="guest-art">
                <span class="guest-art-label">{guest.badge}</span>
                {guest.image ? (
                  <img src={guest.image} alt={`${guest.name} no Family Game Festival`} loading="lazy" />
                ) : (
                  <div class="guest-mystery-art" role="img" aria-label="Identidade do jurado será revelada em breve">
                    <strong>?</strong>
                    <span>IDENTIDADE<br />EM BREVE</span>
                  </div>
                )}
                <span class="guest-art-number">FGF 26</span>
              </div>
              <div class="guest-content">
                <p class="card-eyebrow">{guest.role}</p>
                <h3>{guest.name}</h3>
                <p>{guest.description}</p>
                <p class="guest-highlight">{guest.highlight}</p>
                {guest.instagramUrl ? (
                  <a class="text-link" href={guest.instagramUrl} target="_blank" rel="noreferrer">{guest.handle} <span aria-hidden="true">↗</span></a>
                ) : (
                  <span class="guest-mystery-link">Revelação em breve</span>
                )}
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <section class="section section-dark guest-videos-section" id="videos" aria-labelledby="guest-videos-title">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-cyan">Conteúdo dos convidados</p><h2 id="guest-videos-title">Vídeos que entram em cena.</h2></div>
          <p class="heading-note heading-note-light">Recados, convites, bastidores e apresentações dos convidados do Family Game Festival.</p>
          <img class="section-mascot section-mascot-here" src="/assets/mascots/5 - Pose Convidando.svg" alt="" aria-hidden="true" />
        </div>

        <div class="guest-video-grid">
          {guestVideos.map((video) => (
            <article class="guest-video-card">
              <div class="guest-video-media">
                <video controls preload="metadata" aria-label={`Vídeo de ${video.title}`}>
                  <source src={`/assets/videos/${encodeURIComponent(video.filename)}`} type={video.sourceType} />
                  Seu navegador não consegue reproduzir este vídeo.
                </video>
              </div>
              <div class="guest-video-content">
                <p class="card-eyebrow">Vídeo do convidado</p>
                <h3>{video.title}</h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-light exhibitors-section" id="expositores" aria-labelledby="exhibitors-title">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-cyan">Expositores</p><h2 id="exhibitors-title">Lojas e Artist Alley.</h2></div>
          <p class="heading-note">Conheça as lojas que estarão na arena e as lojinhas de artistas independentes do festival.</p>
          <img class="section-mascot section-mascot-ok" src="/assets/mascots/4 - Pose Ok.svg" alt="" aria-hidden="true" />
        </div>

        <section class="artist-alley stores-showcase" id="lojas" aria-labelledby="stores-title">
          <div class="artist-alley-header">
            <div><p class="eyebrow eyebrow-yellow">Lojas</p><h3 id="stores-title">Lojas</h3></div>
            <p>Encontre produtos, games e novidades das lojas confirmadas no Family Game Festival.</p>
          </div>
          <div class="artist-alley-grid">
            {stores.map((store, index) => (
              <article class={`artist-alley-card store-card artist-alley-${store.accent}`}>
                <div class="artist-alley-art store-art"><img src={store.image} alt={`Logo ${store.name}`} loading="lazy" /></div>
                <div class="artist-alley-copy">
                  <span class="artist-alley-index">0{index + 1}</span>
                  <p class="card-eyebrow">{store.role}</p>
                  <h4>{store.name}</h4>
                  <p>{store.description}</p>
                  <a class="text-link" href={store.href} target="_blank" rel="noreferrer">{store.handle} <span aria-hidden="true">↗</span></a>
                  <span class="artist-alley-note">{store.note}</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="artist-alley artist-alley-showcase" id="artist-alley" aria-labelledby="artist-alley-title">
          <div class="artist-alley-header">
            <div><p class="eyebrow eyebrow-cyan">Artist Alley</p><h3 id="artist-alley-title">Artist Alley</h3></div>
            <p>Uma área com lojinhas de artistas independentes. Ainda dá tempo de se inscrever e participar do Artist Alley.</p>
          </div>
          <div class="artist-alley-grid">
            {artistAlleyArtists.map((artist, index) => (
              <article class={`artist-alley-card artist-alley-${artist.accent}`}>
                <div class="artist-alley-art"><img src={artist.image} alt={`${artist.name} no Artist Alley do Family Game Festival`} loading="lazy" /></div>
                <div class="artist-alley-copy">
                  <span class="artist-alley-index">0{index + 1}</span>
                  <p class="card-eyebrow">{artist.role}</p>
                  <h4>{artist.name}</h4>
                  <p>{artist.description}</p>
                  <p class="artist-alley-detail">{artist.detail}</p>
                  <a class="text-link" href={artist.instagramUrl} target="_blank" rel="noreferrer">{artist.handle} <span aria-hidden="true">↗</span></a>
                  <span class="artist-alley-note">{artist.note}</span>
                </div>
              </article>
            ))}
          </div>
          <div class="artist-alley-footer"><div><span>ARTE · CRIAÇÃO · COMUNIDADE</span><strong>ENCONTRE SEU PRÓXIMO FAVORITO ↗</strong></div><a class="button button-yellow button-small" href={event.whatsapp.artistAlley} target="_blank" rel="noreferrer">Inscreva-se no Artist Alley <span aria-hidden="true">↗</span></a></div>
        </section>

        <div class="exhibitor-cta">
          <div class="exhibitor-cta-copy">
            <p class="eyebrow eyebrow-cyan">Expositores & lojistas</p>
            <h2>Leve sua marca para dentro do jogo também.</h2>
            <p>Espaços para lojistas e expositores no Family Game Festival. Veja como participar ou fale diretamente com a organização.</p>
          </div>
          <div class="exhibitor-actions">
            <a class="button button-red" href="/expositores">Veja como ser expositor <span aria-hidden="true">↗</span></a>
          </div>
          <img class="exhibitor-mascot" src="/assets/mascots/4 - Pose Ok.svg" alt="" aria-hidden="true" />
        </div>
      </div>
    </section>

    <section class="section section-navy tournaments-section" id="campeonatos">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-yellow">Programação competitiva</p><h2>Escolha seu campeonato.</h2></div>
          <img class="section-mascot section-mascot-fight" src="/assets/mascots/3 - Pose Luta.svg" alt="" aria-hidden="true" />
        </div>

        <div class="tournament-day-tabs" role="tablist" aria-label="Escolha o dia dos campeonatos">
          {homeCompetitionPanels.map((panel, index) => (
            <button class={`tournament-day-tab ${index === 0 ? 'is-active' : ''}`} id={`home-${panel.slug}-tab`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`home-${panel.slug}-panel`} data-home-day-tab={panel.slug}>
              <span>{panel.day}</span><small>{panel.date}</small>
            </button>
          ))}
        </div>

        {homeCompetitionPanels.map((panel, panelIndex) => (
          <div class={`home-competition-panel tournament-day-panel ${panelIndex === 0 ? 'is-active' : ''}`} id={`home-${panel.slug}-panel`} role="tabpanel" aria-labelledby={`home-${panel.slug}-tab`} data-home-day-panel={panel.slug} hidden={panelIndex !== 0}>
            <div class="home-competition-list">
              {panel.featuredEntries.length > 0 && (
                <div class={`competition-group competition-special-group ${panel.featuredEntries.length === 1 ? 'competition-special-group-single' : ''}`}>
                  <div class="competition-group-heading">
                    <div><p class="card-eyebrow">Destaque do palco</p><h3>{panel.featuredEntries[0].tournament.category === 'Dance Game' ? 'Competição de Dança' : 'Cosplay'}</h3></div>
                    <span>{panel.featuredEntries.length} {panel.featuredEntries.length === 1 ? 'atração' : 'atrações'}</span>
                  </div>
                  <div class="home-competition-accordion-list">
                    {panel.featuredEntries.map((entry) => <HomeCompetitionAccordion entry={entry} categoryLabel={entry.tournament.category === 'Dance Game' ? 'Competição de Dança' : 'Cosplay'} featured />)}
                  </div>
                </div>
              )}

              {panel.groupedEntries.map((group) => (
                <div class={`competition-group competition-group-${group.accent}`}>
                  <div class="competition-group-heading">
                    <div><p class="card-eyebrow">{group.kicker}</p><h3>{group.title}</h3></div>
                    <span>{group.entries.length} disputas</span>
                  </div>
                  <div class="home-competition-accordion-list">
                    {group.entries.map((entry, index) => <HomeCompetitionAccordion entry={entry} categoryLabel={group.kicker} number={index + 1} />)}
                  </div>
                </div>
              ))}

            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section section-light experiences-section">
      <div class="container">
        <div class="section-heading section-heading-with-mascot"><p class="eyebrow eyebrow-cyan">Mais para viver</p><h2>O ingresso abre um mapa inteiro.</h2><img class="section-mascot section-mascot-ok" src="/assets/mascots/4 - Pose Ok.svg" alt="" aria-hidden="true" /></div>
        <div class="experience-grid">
          {experiences.map((experience) => (
            <article class="experience-card">
              <span class="experience-number">{experience.number}</span>
              <img src={`/assets/svg/${experience.icon}`} alt="" aria-hidden="true" />
              <h3>{experience.title}</h3>
              <p>{experience.text}</p>
            </article>
          ))}
        </div>
        <div class="inclusive-note"><img src="/assets/svg/controller.svg" alt="" aria-hidden="true" /><p><strong>Todo mundo tem espaço na partida.</strong> O festival também prepara competições e experiências inclusivas para pessoas com deficiência. Formatos e detalhes serão divulgados conforme confirmação.</p></div>
      </div>
    </section>

    <section class="section section-dark tickets-section" id="ingressos">
      <div class="container">
        <div class="section-heading heading-row section-heading-with-mascot">
          <div><p class="eyebrow eyebrow-yellow">Saiba mais sobre os ingressos</p><h2>Seu próximo fim de semana começa aqui.</h2></div>
          <p class="heading-note heading-note-light">Os valores abaixo não incluem a taxa da plataforma. Garanta seu ingresso na bilheteria oficial.</p>
          <img class="section-mascot section-mascot-here" src="/assets/mascots/1 - Pose Aqui.svg" alt="" aria-hidden="true" />
        </div>
        <div class="ticket-day-panels" aria-label="Ingressos do evento por dia">
          {tickets.map((ticketDay) => (
            <section class={`ticket-day-panel ticket-day-${ticketDay.slug}`} aria-labelledby={`ticket-day-${ticketDay.slug}`}>
              <div class="ticket-day-heading">
                <div><p class="eyebrow eyebrow-cyan">Ingressos do evento</p><h3 id={`ticket-day-${ticketDay.slug}`}>{ticketDay.day}</h3></div>
                <strong>{ticketDay.date}</strong>
              </div>
              <div class="ticket-day-grid">
                {ticketDay.passes.map((ticket) => (
                  <article class={`ticket-card ticket-${ticket.accent}`}>
                    <div class="ticket-card-top"><p><span class="ticket-card-icon" aria-hidden="true">{ticket.icon}</span>{ticket.name}</p><span aria-hidden="true">✦</span></div>
                    <strong>{ticket.price}</strong>
                    <small>{ticket.fee}</small>
                    <h4>{ticket.detail}</h4>
                    <p>{ticket.note}</p>
                    <div class="ticket-installments">{ticket.installments}</div>
                    <a class="text-link text-link-light" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar na Eventiza <span aria-hidden="true">↗</span></a>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div class="vip-highlight">
          <div class="vip-art"><img src="/assets/logos/bag-vip.png" alt="Bag VIP Diamante Family Game Festival" /></div>
          <div class="vip-content">
            <p class="eyebrow eyebrow-yellow">Edição limitada · acesso aos dois dias</p>
            <div class="vip-title-row"><div><h3>VIP Diamante Family Game</h3><p>Somente 100 unidades · entrada 1 hora antes da abertura.</p></div><span class="vip-stamp">VIP<br /><small>FGF 26</small></span></div>
            <ul class="vip-benefits">
              <li><strong>2 dias</strong> de festival</li>
              <li><strong>Entrada prioritária</strong> e credencial VIP exclusiva</li>
              <li><strong>3 brindes</strong> exclusivos Family Game</li>
              <li>Não inclui inscrição nos campeonatos</li>
            </ul>
            <div class="vip-option-grid">
              {vipTickets.map((vip) => (
                <article class="vip-option">
                  <p class="vip-option-audience">{vip.audience}</p>
                  <strong>{vip.price}</strong>
                  <span>{vip.fee}</span>
                  <small>{vip.installments}</small>
                  <a class="button button-yellow" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar VIP <span aria-hidden="true">↗</span></a>
                </article>
              ))}
            </div>
            <p class="vip-warning">Experiência especial para viver o festival com benefícios exclusivos. A compra é feita pela Eventiza.</p>
          </div>
        </div>

        <div class="competitor-tickets">
          <div class="competitor-heading">
            <div><p class="eyebrow eyebrow-pink">Ingressos de competição</p><h3>Compre seu ingresso competidor.</h3></div>
            <p>Compre o ingresso competidor ou o ingresso comum do evento. Inscrições online até {ONLINE_REGISTRATION_DEADLINE_LABEL}. {ONLINE_REGISTRATION_ONSITE_NOTICE} O ingresso competidor já inclui a entrada no evento no dia da disputa.</p>
          </div>
          <div class="competitor-day-panels">
            {competitorTicketDays.map((ticketDay) => (
              <section class={`competitor-day-panel competitor-day-${ticketDay.slug}`} aria-labelledby={`competitor-day-${ticketDay.slug}`}>
                <div class="competitor-day-heading"><div><p class="eyebrow eyebrow-cyan">Ingressos de competidor</p><h4 id={`competitor-day-${ticketDay.slug}`}>{ticketDay.day}</h4></div><strong>{ticketDay.date} · {ticketDay.entries.length} modalidades</strong></div>
                <div class="competitor-carousel" data-ticket-carousel>
                  <div class="competitor-carousel-controls">
                    <span>Carrossel automático · deslize ou use as setas</span>
                    <div>
                    <button class="competitor-carousel-button" type="button" data-ticket-prev aria-label={`Ver ingressos anteriores de ${ticketDay.day.toLowerCase()}`} disabled>←</button>
                      <button class="competitor-carousel-button" type="button" data-ticket-next aria-label={`Ver próximos ingressos de ${ticketDay.day.toLowerCase()}`}>→</button>
                    </div>
                  </div>
                  <div class="competitor-ticket-grid" data-ticket-track tabindex="0" aria-label={`Ingressos de competidor de ${ticketDay.day.toLowerCase()}`}>
                    {ticketDay.entries.map((entry) => (
                      <article class={`competitor-ticket-card ticket-${entry.accent}`} data-ticket-card>
                        <div class="competitor-ticket-top"><span class="competitor-ticket-icon" aria-hidden="true">{entry.icon}</span><span class="competitor-ticket-label">COMPETIDOR</span></div>
                        <h5>{entry.tournament.title}</h5>
                        <p class="competitor-ticket-schedule">{entry.schedule.date} · {entry.schedule.day} · {entry.schedule.time}</p>
                        <p class:list={['competitor-ticket-access', entry.registrationFree && 'is-free']}>{entry.eventAccessNote}</p>
                        <div class="competitor-ticket-price"><strong>{entry.price}</strong><span>{entry.fee}</span></div>
                        <p class="competitor-ticket-installments">{entry.installments}</p>
                        <p class="competitor-ticket-prize"><span>PREMIAÇÃO</span>{entry.tournament.prize || '—'}</p>
                        <p class="competitor-ticket-note">{entry.note}</p>
                        {entry.registrationFree ? <span class="competitor-ticket-free">Inscrição gratuita</span> : <a class="text-link text-link-light" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar ingresso competidor <span aria-hidden="true">↗</span></a>}
                      </article>
                    ))}
                  </div>
                  <div class="competitor-carousel-status" aria-live="polite"><span data-ticket-status></span><small>Compre na Eventiza · Just Dance tem inscrição gratuita.</small></div>
                </div>
              </section>
            ))}
          </div>
        </div>

        <div class="ticket-footer"><p><strong>Quer jogar os dois dias?</strong> O VIP dá acesso completo ao festival, com entrada uma hora antes e benefícios exclusivos.</p><a class="button button-yellow" href={event.ticketUrl} target="_blank" rel="noreferrer">Garantir meu ingresso <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="section sponsor-home-section" id="patrocinadores">
      <div class="container">
