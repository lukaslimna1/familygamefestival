---
import AdminIcon from '../../components/admin/AdminIcon.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  formatAdminDate,
  getAdminDashboardData,
  getAdminServiceStatus
} from '../../lib/server/admin/data';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect('/admin/login');
if (admin.mustChangePassword) return Astro.redirect('/admin/account/password');

const data = await getAdminDashboardData();
const services = getAdminServiceStatus();
const pendingTotal = data.attention.authorizations + data.attention.physical + data.attention.driveErrors + data.attention.cosplayWithoutAudio;

const statusLabel = (status: string) => ({
  pending: 'Pendente',
  synced: 'Sincronizada',
  failed: 'Falha',
  cancelled: 'Cancelada'
}[status] ?? status);

const formatCount = (value: number) => value.toLocaleString('pt-BR');
---

<AdminLayout
  title="Dashboard | Family Game Festival"
  subtitle="Acompanhe inscrições, vagas e pendências do evento."
  admin={admin}
  action={{ label: 'Ver inscrições', href: '/admin/inscricoes' }}
  notificationCount={pendingTotal}
>
  <div class="admin-v2-page admin-v2-dashboard">
    <section class="admin-v2-hero">
      <div>
        <p class="admin-eyebrow">Family Game Festival 2026 · operação</p>
        <h2>Olá, {admin.displayName}.</h2>
        <p>Uma visão rápida do que entrou, do que precisa de atenção e de como estão as competições.</p>
      </div>
      <div class="admin-v2-hero-date">
        <span>Próxima edição</span>
        <strong>19—20 SET</strong>
        <small>Bauru · SP</small>
      </div>
    </section>

    <section class="admin-v2-kpi-grid" aria-label="Indicadores principais">
      <a class="admin-v2-kpi kpi-yellow" href="/admin/inscricoes">
        <span class="admin-v2-kpi-icon"><AdminIcon name="clipboard" /></span>
        <span class="admin-v2-kpi-value">{formatCount(data.stats.total)}</span>
        <span class="admin-v2-kpi-label">Inscrições totais</span>
        <small>Base ativa do evento</small>
      </a>
      <a class="admin-v2-kpi kpi-cyan" href="/admin/inscricoes?today=1">
        <span class="admin-v2-kpi-icon"><AdminIcon name="arrow" /></span>
        <span class="admin-v2-kpi-value">{formatCount(data.stats.today)}</span>
        <span class="admin-v2-kpi-label">Entraram hoje</span>
        <small>Por data de envio</small>
      </a>
      <a class="admin-v2-kpi kpi-magenta" href="/admin/menores">
        <span class="admin-v2-kpi-icon"><AdminIcon name="shield" /></span>
        <span class="admin-v2-kpi-value">{formatCount(data.stats.minors)}</span>
        <span class="admin-v2-kpi-label">Participantes menores</span>
        <small>Responsável necessário</small>
      </a>
      <a class="admin-v2-kpi kpi-red" href="/admin/menores?status=pending">
        <span class="admin-v2-kpi-icon"><AdminIcon name="folder" /></span>
        <span class="admin-v2-kpi-value">{formatCount(data.stats.pendingAuthorizations)}</span>
        <span class="admin-v2-kpi-label">Autorizações pendentes</span>
        <small>Requerem acompanhamento</small>
      </a>
      <a class="admin-v2-kpi kpi-purple" href="/admin/inscricoes?full=1">
        <span class="admin-v2-kpi-icon"><AdminIcon name="grid" /></span>
        <span class="admin-v2-kpi-value">{formatCount(data.stats.fullCompetitions)}</span>
        <span class="admin-v2-kpi-label">Competições cheias</span>
        <small>Limite alcançado</small>
      </a>
      <a class="admin-v2-kpi kpi-green" href="/admin/inscricoes">
        <span class="admin-v2-kpi-icon"><AdminIcon name="spark" /></span>
        <span class="admin-v2-kpi-value">{formatCount(data.stats.remainingSlots)}</span>
        <span class="admin-v2-kpi-label">Vagas restantes</span>
        <small>Somatório das modalidades</small>
      </a>
    </section>

    <div class="admin-v2-dashboard-grid">
      <section class="admin-v2-card admin-v2-chart-card" aria-labelledby="competition-pulse-title">
        <div class="admin-v2-card-heading">
          <div>
            <p class="admin-section-kicker">Capacidade</p>
            <h2 id="competition-pulse-title">Ocupação por competição</h2>
            <p>Dados reais do banco · clique em uma modalidade para abrir a lista.</p>
          </div>
          <span class="admin-v2-card-mark">{data.competitions.length}</span>
        </div>
        <div class="admin-v2-competition-chart">
          {data.competitions.map((competition) => (
            <a class="admin-v2-competition-row" href={'/admin/inscricoes?competition=' + competition.id}>
              <span class="admin-v2-competition-name">
                <strong>{competition.title}</strong>
                <small>{competition.category}</small>
              </span>
              <span class="admin-v2-bar"><span style={'width: ' + Math.min(100, competition.capacity ? (competition.enrolled / competition.capacity) * 100 : 0) + '%'}></span></span>
              <span class="admin-v2-competition-count"><strong>{competition.enrolled}</strong><small>/{competition.capacity}</small></span>
            </a>
          ))}
        </div>
      </section>

      <section class="admin-v2-card" aria-labelledby="attention-title">
        <div class="admin-v2-card-heading">
          <div>
            <p class="admin-section-kicker">Fila de trabalho</p>
            <h2 id="attention-title">Pendências</h2>
          </div>
          <span class:list={['admin-v2-count-badge', { 'is-clear': pendingTotal === 0 }]}>{pendingTotal}</span>
        </div>
        <div class="admin-v2-attention-list">
          <a href="/admin/menores?status=pending"><span class="attention-icon attention-red"><AdminIcon name="shield" /></span><span><strong>Autorizações de menores</strong><small>Documentos sem assinatura validada</small></span><b>{data.attention.authorizations}</b></a>
          <a href="/admin/menores?status=physical_pending"><span class="attention-icon attention-yellow"><AdminIcon name="folder" /></span><span><strong>Entrega física</strong><small>Aguardando conferência no evento</small></span><b>{data.attention.physical}</b></a>
          <a href="/admin/inscricoes?status=drive_failed"><span class="attention-icon attention-magenta"><AdminIcon name="folder" /></span><span><strong>Sincronização de arquivos</strong><small>Falhas registradas pelo Drive</small></span><b>{data.attention.driveErrors}</b></a>
          <a href="/admin/cosplay?status=without_audio"><span class="attention-icon attention-cyan"><AdminIcon name="spark" /></span><span><strong>Cosplay sem áudio</strong><small>Arquivo ainda não localizado</small></span><b>{data.attention.cosplayWithoutAudio}</b></a>
        </div>
      </section>
    </div>

    <div class="admin-v2-dashboard-grid admin-v2-dashboard-grid-lower">
      <section class="admin-v2-card" aria-labelledby="latest-title">
        <div class="admin-v2-card-heading">
          <div>
            <p class="admin-section-kicker">Movimentação</p>
            <h2 id="latest-title">Últimas inscrições</h2>
          </div>
          <a class="admin-v2-text-link" href="/admin/inscricoes">Ver todas <AdminIcon name="arrow" /></a>
        </div>
        {data.latest.length ? (
          <div class="admin-v2-table-wrap">
            <table class="admin-v2-table">
              <thead><tr><th>Código</th><th>Participante</th><th>Competição</th><th>Envio</th><th>Status</th></tr></thead>
              <tbody>
                {data.latest.map((row) => (
                  <tr>
                    <td><a href={'/admin/inscricoes/' + row.registrationId} class="admin-v2-code">{row.publicCode ?? '—'}</a></td>
                    <td><a href={'/admin/inscricoes/' + row.registrationId}><strong>{row.fullName}</strong><small>{row.isMinor ? 'Menor de idade' : 'Maior de idade'}</small></a></td>
                    <td>{row.competitionTitle}</td>
                    <td>{formatAdminDate(row.submittedAt ?? row.registrationCreatedAt)}</td>
                    <td><span class:list={['admin-v2-status', 'status-' + row.status]}>{statusLabel(row.status)}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="admin-v2-empty"><span class="admin-v2-empty-icon"><AdminIcon name="clipboard" /></span><strong>Nenhuma inscrição registrada ainda.</strong><p>Quando uma inscrição real entrar, ela aparecerá aqui com código, modalidade e status.</p><a href="/admin/inscricoes">Abrir central de inscrições <AdminIcon name="arrow" /></a></div>
        )}
      </section>

      <section id="admin-status" class="admin-v2-card" aria-labelledby="system-title">
        <div class="admin-v2-card-heading">
          <div>
            <p class="admin-section-kicker">Saúde da operação</p>
            <h2 id="system-title">Status do sistema</h2>
          </div>
          <span class="admin-v2-live"><i></i>Ativo</span>
        </div>
        <div class="admin-v2-system-list">
          <div><span class="system-icon"><AdminIcon name="grid" /></span><span><strong>Turso</strong><small>Banco de dados</small></span><b class:list={{ 'is-ok': services.turso }}>{services.turso ? 'Conectado' : 'Indisponível'}</b></div>
          <div><span class="system-icon"><AdminIcon name="folder" /></span><span><strong>Google Drive</strong><small>Arquivos e documentos</small></span><b class:list={{ 'is-ok': services.drive }}>{services.drive ? 'Configurado' : 'Indisponível'}</b></div>
          <div><span class="system-icon"><AdminIcon name="lock" /></span><span><strong>Sessão administrativa</strong><small>Acesso autenticado</small></span><b class="is-ok">Ativa</b></div>
          <div><span class="system-icon"><AdminIcon name="arrow" /></span><span><strong>Última sincronização</strong><small>Registro mais recente confirmado</small></span><b>{data.latestSyncAt ? formatAdminDate(data.latestSyncAt) : 'Nenhuma ainda'}</b></div>
        </div>
      </section>
    </div>
  </div>
</AdminLayout>
