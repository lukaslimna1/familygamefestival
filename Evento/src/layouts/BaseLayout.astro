---
import '../styles/global.css';
import { event } from '../data/event';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  manifest?: string;
  bodyClass?: string;
}

const siteUrl = 'https://familygamefestival.vercel.app';
const eventImageUrl = `${siteUrl}/assets/flyers/festival-logo.jpg`;

const {
  title = 'Family Game Festival 2026 | Evento Geek em Bauru/SP',
  description = 'Family Game Festival 2026 em Bauru/SP: games, campeonatos, cosplay, K-Pop, Just Dance e cultura geek nos dias 19 e 20 de setembro.',
  canonical = `${siteUrl}/`,
  structuredData,
  manifest,
  bodyClass,
} = Astro.props;

const mainEventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.name,
  description,
  startDate: '2026-09-19T11:00:00-03:00',
  endDate: '2026-09-20T21:00:00-03:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      streetAddress: event.address.split(' · ')[0],
      addressLocality: 'Bauru',
      addressRegion: 'SP',
      addressCountry: 'BR'
    }
  },
  image: eventImageUrl,
  organizer: { '@type': 'Organization', name: 'Family Game Festival', url: siteUrl },
  url: `${siteUrl}/`
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Family Game Festival',
  url: `${siteUrl}/`
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Family Game Festival',
  url: `${siteUrl}/`,
  logo: `${siteUrl}/assets/logo.png`,
  sameAs: [event.instagramUrl]
};

const pageSchemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const jsonLd = canonical === `${siteUrl}/`
  ? [mainEventSchema, websiteSchema, organizationSchema, ...pageSchemas]
  : pageSchemas;
---
<!doctype html>
<html lang="pt-BR" class={bodyClass ? bodyClass : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08111f" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    {manifest && <link rel="manifest" href={manifest} />}
    <meta property="og:site_name" content="Family Game Festival" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={eventImageUrl} />
    <meta property="og:image:alt" content="Logo do Family Game Festival 2026" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={eventImageUrl} />
    <meta name="twitter:image:alt" content="Logo do Family Game Festival 2026" />
    <title>{title}</title>
    {jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <Analytics />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
