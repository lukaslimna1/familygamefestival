---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import RegistrationForm from '../../components/RegistrationForm.astro';
import { event } from '../../data/event';
import { championshipEntries, getChampionshipEntry } from '../../data/championships';

export const prerender = true;

export function getStaticPaths() {
  return championshipEntries.map((entry) => ({
    params: { competition: entry.tournament.id },
    props: { entry }
  }));
}

const entry = Astro.props.entry || getChampionshipEntry(Astro.params.competition || '');
if (!entry) return Astro.redirect('/#campeonatos');
---

<BaseLayout
  title={`Inscrição · ${entry.tournament.title} | ${event.name}`}
  description={`Faça sua inscrição para ${entry.tournament.title} no Family Game Festival 2026.`}
  canonical={`https://familygamefestival.vercel.app/inscricao/${entry.tournament.id}`}
>
  <SiteHeader current="Campeonatos" />
  <main>
    <RegistrationForm entry={entry} />
  </main>
  <footer class="site-footer">
    <div class="container footer-top"><a class="brand" href="/"><img src="/assets/logo.svg" alt="Family Game Festival" /></a><p>Games, cultura geek e impacto local.<br />Bauru · 19—20 setembro 2026</p><a class="button button-yellow button-small" href={event.ticketUrl} target="_blank" rel="noreferrer">Comprar ingresso <span aria-hidden="true">↗</span></a></div>
    <div class="container footer-bottom"><span>© 2026 Family Game Festival</span><a href={event.instagramUrl} target="_blank" rel="noreferrer">{event.instagram}</a><span>{event.socialImpact}</span><span class="footer-credit">Desenvolvido pela <a href="https://www.instagram.com/usealterstate/" target="_blank" rel="noreferrer">ALTERSTATE</a></span></div>
  </footer>
</BaseLayout>
