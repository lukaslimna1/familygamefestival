---
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatAdminDate, whatsappUrl } from '../../../lib/server/admin/data';
import { getNewsletterStats, listNewsletterLeads } from '../../../lib/server/newsletter/repository';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect('/admin/login');
if (admin.mustChangePassword) return Astro.redirect('/admin/account/password');

const query = Astro.url.searchParams;
const search = query.get('q') ?? '';
const page = Math.max(1, Number(query.get('page') || 1));
const pageSize = 50;

const [stats, listResult] = await Promise.all([
  getNewsletterStats(),
  listNewsletterLeads({
    search: search || undefined,
    limit: pageSize,
    offset: (page - 1) * pageSize
  })
]);

const rows = listResult.items;
const total = listResult.total;
const totalPages = Math.ceil(total / pageSize);
---

<AdminLayout
  title="Newsletter & Leads | Family Game Festival"
  subtitle="Lista VIP e pessoas interessadas nas próximas edições do festival."
  admin={admin}
  search={{ action: '/admin/newsletter', value: search, placeholder: 'Buscar por nome, e-mail ou WhatsApp' }}
>
  <div class="admin-v2-page admin-v2-cosplay-page">
    <section class="admin-v2-page-intro admin-v2-cosplay-intro">
      <div>
        <p class="admin-eyebrow">Relacionamento · Leads & Comunidade</p>
        <h2>Newsletter & Lista VIP</h2>
        <p>Contatos cadastrados na página inicial para receber novidades, fotos e ingressos em primeira mão.</p>
      </div>
      <div class="admin-v2-cosplay-capacity">
        <span>Base Total</span>
        <strong>{stats.total}<small> contatos</small></strong>
        <i><span style="width: 100%;"></span></i>
        <small>Interessados nas próximas edições</small>
      </div>
    </section>

    <!-- KPIs -->
    <section class="admin-v2-kpi-grid" aria-label="Resumo administrativo da Newsletter">
      <article class="admin-v2-kpi kpi-magenta">
        <span class="admin-v2-kpi-icon"><AdminIcon name="folder" /></span>
        <strong class="admin-v2-kpi-value">{stats.total}</strong>
        <span class="admin-v2-kpi-label">Total Cadastrado</span>
        <small>Contatos únicos na base</small>
      </article>

      <article class="admin-v2-kpi kpi-green">
        <span class="admin-v2-kpi-icon"><AdminIcon name="whatsapp" /></span>
        <strong class="admin-v2-kpi-value">{stats.comWhatsapp}</strong>
        <span class="admin-v2-kpi-label">Com WhatsApp</span>
        <small>Prontos para disparos (base global)</small>
      </article>

      <article class="admin-v2-kpi kpi-yellow">
        <span class="admin-v2-kpi-icon"><AdminIcon name="spark" /></span>
        <strong class="admin-v2-kpi-value">{stats.hoje}</strong>
        <span class="admin-v2-kpi-label">Cadastros Hoje</span>
        <small>Novos contatos nas últimas 24h</small>
      </article>

      <article class="admin-v2-kpi kpi-cyan">
        <span class="admin-v2-kpi-icon"><AdminIcon name="folder" /></span>
        <strong class="admin-v2-kpi-value">{total}</strong>
        <span class="admin-v2-kpi-label">Filtro Atual</span>
        <small>Encontrados nesta busca</small>
      </article>
    </section>

    <!-- Barra de Ações & Filtro -->
    <section class="admin-v2-card admin-v2-filter-card" aria-label="Filtros da Newsletter">
      <form class="admin-v2-filter-form" method="get">
        <label class="admin-v2-filter-wide">
          Busca
          <input
            name="q"
            value={search}
            placeholder="Nome, e-mail ou número de telefone"
          />
        </label>
        <button class="admin-button admin-button-primary" type="submit">Buscar</button>
        <a class="admin-button admin-button-secondary" href="/admin/newsletter">Limpar</a>
        <a
          class="admin-button admin-button-secondary"
          href={`/api/admin/newsletter/export${search ? `?q=${encodeURIComponent(search)}` : ''}`}
          download
          style="margin-left: auto;"
          title="Exportar todos os registros correspondentes da base em formato CSV"
        >
          <AdminIcon name="download" />
          <span>Exportar Base Completa (CSV)</span>
        </a>
      </form>
    </section>

    <!-- Tabela de Contatos -->
    <section class="admin-v2-card admin-v2-table-card" aria-label="Lista de Inscritos na Newsletter">
      <div class="admin-v2-card-heading">
        <div>
          <p class="admin-section-kicker">Base de contatos</p>
          <h2>Inscritos na Newsletter</h2>
          <p>Exibindo {rows.length} de {total} registros encontrados.</p>
        </div>
      </div>

      {rows.length > 0 ? (
        <div class="admin-v2-table-wrap">
          <table class="admin-v2-table" id="leads-table">
            <thead>
              <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>WhatsApp</th>
                <th>Origem</th>
                <th>Data de Inscrição</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((lead) => {
                const wa = whatsappUrl(lead.whatsapp);
                return (
                  <tr>
                    <td>
                      <strong style="color: #fff;">{lead.nome}</strong>
                    </td>
                    <td>
                      <span style="color: var(--admin-cyan);">{lead.email}</span>
                    </td>
                    <td>
                      {lead.whatsapp ? (
                        <span>{lead.whatsapp}</span>
                      ) : (
                        <span style="color: var(--admin-muted); font-size: 0.72rem;">Não informado</span>
                      )}
                    </td>
                    <td>
                      <span class="admin-v2-chip">{lead.origem || 'home'}</span>
                    </td>
                    <td>
                      <span style="color: var(--admin-muted); font-size: 0.72rem;">
                        {formatAdminDate(lead.createdAt)}
                      </span>
                    </td>
                    <td>
                      {wa && (
                        <a
                          class="admin-button admin-button-secondary"
                          href={wa}
                          target="_blank"
                          rel="noreferrer"
                          style="font-size: 0.7rem; padding: 0.25rem 0.5rem;"
                          title="Abrir conversa no WhatsApp"
                        >
                          <AdminIcon name="whatsapp" />
                          <span>Chamar</span>
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="admin-v2-empty">
          <span class="admin-v2-empty-icon"><AdminIcon name="spark" /></span>
          <strong>Nenhum contato encontrado.</strong>
          <p>Os cadastros realizados no formulário de newsletter da Home serão listados aqui em tempo real.</p>
        </div>
      )}

      {totalPages > 1 && (
        <div class="admin-v2-toolbar-count" style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 1rem;">
          {page > 1 && (
            <a class="admin-button admin-button-secondary" href={`/admin/newsletter?page=${page - 1}&q=${encodeURIComponent(search)}`}>
              ← Anterior
            </a>
          )}
          <span style="align-self: center; font-size: 0.72rem; color: var(--admin-muted);">
            Página {page} de {totalPages}
          </span>
          {page < totalPages && (
            <a class="admin-button admin-button-secondary" href={`/admin/newsletter?page=${page + 1}&q=${encodeURIComponent(search)}`}>
              Próxima →
            </a>
          )}
        </div>
      )}
    </section>
  </div>
</AdminLayout>
