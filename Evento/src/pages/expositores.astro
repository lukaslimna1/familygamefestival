---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { event } from '../data/event';

export const prerender = true;

const proposalPdf = '/assets/docs/proposta-comercial-expositores.pdf';
const structureItems = [
  { label: 'Espaço modular', title: '3 × 3 m por unidade', text: 'Contrate mais de um espaço e amplie sua operação conforme disponibilidade.' },
  { label: 'Circulação', title: 'Todo mundo passa por aqui', text: 'Os espaços ficam na mesma área de circulação do público do festival.' },
  { label: 'Ambiente', title: 'Coberto e protegido', text: 'Arena protegida de chuva, vento e exposição direta ao sol.' },
  { label: 'Infraestrutura', title: 'Energia e estacionamento', text: 'Pontos de energia elétrica e estacionamento disponíveis para lojistas.' }
] as const;
const includedItems = [
  { number: '01', title: '2 credenciais', text: 'Duas identificações gratuitas de expositor para a equipe da loja.', accent: 'cyan' },
  { number: '02', title: 'Alimentação', text: 'Almoço, lanche e bebida para duas pessoas nos dois dias.', accent: 'yellow' },
  { number: '03', title: 'Energia', text: 'Pontos de energia elétrica disponíveis para a operação.', accent: 'pink' },
  { number: '04', title: 'Estacionamento', text: 'Estacionamento disponível para lojistas e expositores.', accent: 'red' },
  { number: '05', title: 'Espaço coberto', text: 'Ambiente fechado e protegido durante todo o festival.', accent: 'cyan' },
  { number: '06', title: 'Segurança', text: 'Equipe de segurança presente durante o funcionamento do evento.', accent: 'yellow' }
] as const;
const productCategories = ['Moda geek', 'Colecionáveis', 'Games', 'Impressão 3D', 'Artesanato', 'Decoração', 'Tecnologia', 'Cultura pop'];
const promotionItems = [
  { title: 'Site oficial', text: 'Presença em uma área dedicada aos lojistas e expositores participantes.', accent: 'cyan' },
  { title: 'Redes sociais', text: 'Divulgação individual da loja e publicações conjuntas com os expositores confirmados.', accent: 'yellow' },
  { title: 'Menção no palco', text: 'Os lojistas participantes serão mencionados durante a programação do festival.', accent: 'pink' }
] as const;
---

<BaseLayout
  title="Expositores, lojas e Artist Alley | Family Game Festival 2026"
  description="Conheça as lojas, expositores e artistas do Artist Alley do Family Game Festival 2026, em Bauru/SP."
  canonical="https://familygamefestival.vercel.app/expositores"
>
  <SiteHeader current="Expositores" />

  <main>
    <section class="sponsor-guide-hero exhibitor-guide-hero exhibitor-proposal-hero">
      <div class="container exhibitor-proposal-hero-grid">
        <div>
          <p class="eyebrow eyebrow-cyan">Proposta comercial · espaços para expositores</p>
          <h1>Sua loja <em>entra no jogo.</em></h1>
          <p>Dois dias para vender, apresentar sua marca e fazer parte da experiência presencial do Family Game Festival.</p>
          <div class="exhibitor-proposal-eventline"><span>19 + 20 SET 2026</span><span>11H ÀS 21H</span><span>ARENA TAUSTE · SORRI BAURU</span></div>
          <div class="sponsor-page-actions"><a class="button button-yellow" href={proposalPdf} target="_blank" rel="noreferrer">Abrir proposta completa <span aria-hidden="true">↗</span></a><a class="button button-outline-light" href="/#expositores">Voltar ao festival <span aria-hidden="true">↩</span></a></div>
        </div>
        <div class="exhibitor-proposal-price-card">
          <p class="eyebrow eyebrow-yellow">Espaço comercial</p>
          <p class="exhibitor-proposal-price-label">3 × 3 m · dois dias</p>
          <div class="exhibitor-proposal-price"><span>R$</span><strong>900</strong></div>
          <p class="exhibitor-proposal-price-caption">Participação nos dois dias de evento</p>
          <div class="exhibitor-proposal-payment"><div><strong>R$ 300</strong><span>na reserva</span></div><div><strong>R$ 600</strong><span>no dia do evento</span></div></div>
          <p class="exhibitor-proposal-no-commission">Sem comissão sobre suas vendas.</p>
        </div>
      </div>
    </section>

    <section class="section section-light exhibitor-proposal-structure">
      <div class="container">
        <div class="section-heading exhibitor-proposal-heading"><p class="eyebrow eyebrow-red">Seu espaço no festival</p><h2>Monte sua operação com liberdade.</h2></div>
        <div class="exhibitor-proposal-structure-grid">
          <div class="exhibitor-proposal-structure-copy"><p>Todos os expositores ficam dentro da mesma área comercial e podem montar a operação de acordo com a sua marca, respeitando as orientações do local.</p><a class="text-link" href={proposalPdf} target="_blank" rel="noreferrer">Ler a proposta em PDF <span aria-hidden="true">↗</span></a></div>
          <div class="exhibitor-proposal-spec-grid">{structureItems.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><p>{item.label}</p><h3>{item.title}</h3><small>{item.text}</small></article>)}</div>
        </div>
      </div>
    </section>

    <section class="section section-navy exhibitor-proposal-included">
      <div class="container">
        <div class="section-heading exhibitor-proposal-heading"><p class="eyebrow eyebrow-cyan">O que está incluído</p><h2>Base pronta para operar.</h2><p class="heading-note heading-note-light">O pacote já chega com o essencial para sua loja funcionar durante os dois dias.</p></div>
        <div class="exhibitor-proposal-included-grid">{includedItems.map((item) => <article class={`exhibitor-proposal-included-card proposal-accent-${item.accent}`}><span>{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
      </div>
    </section>

    <section class="section section-light exhibitor-proposal-products">
      <div class="container exhibitor-proposal-products-grid">
        <div><p class="eyebrow eyebrow-yellow">Produtos e montagem</p><h2>Venda do seu jeito.</h2><p>Leve produtos ligados ao universo geek e monte sua presença dentro do espaço contratado.</p></div>
        <div class="exhibitor-proposal-products-board"><p class="card-eyebrow">O que combina com o festival</p><div class="exhibitor-proposal-tags">{productCategories.map((category) => <span>{category}</span>)}</div><div class="exhibitor-proposal-rules"><div><strong>Estrutura própria</strong><span>Banners, painéis, araras, prateleiras, televisores, iluminação e expositores podem ser utilizados.</span></div><div><strong>Alimentos e bebidas</strong><span>A comercialização deve ser conversada e autorizada previamente pela organização.</span></div><div><strong>Exclusividade</strong><span>Condições específicas de categoria podem ser alinhadas durante a contratação.</span></div></div></div>
      </div>
    </section>

    <section class="section section-navy exhibitor-proposal-promotion">
      <div class="container">
        <div class="section-heading exhibitor-proposal-heading"><p class="eyebrow eyebrow-pink">Divulgação da sua loja</p><h2>Sua loja não fica só no estande.</h2><p class="heading-note heading-note-light">A contratação também inclui presença na comunicação oficial do Family Game Festival.</p></div>
        <div class="exhibitor-proposal-promotion-grid">{promotionItems.map((item, index) => <article class={`proposal-promotion-card proposal-accent-${item.accent}`}><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
        <p class="exhibitor-proposal-logo-note"><strong>Material necessário:</strong> envie o logotipo na melhor qualidade possível, preferencialmente com fundo transparente.</p>
      </div>
    </section>

    <section class="section exhibitor-guide-contact exhibitor-proposal-final">
      <div class="container exhibitor-proposal-final-grid"><div><p class="eyebrow eyebrow-yellow">Vagas limitadas para expositores</p><h2>Reserve sua loja dentro do festival.</h2><p>Reserva até 15/09/2026, enquanto houver vagas disponíveis. Fale diretamente com o Juruna para receber os próximos passos.</p></div><div class="exhibitor-proposal-final-actions"><a class="button button-yellow" href={event.whatsapp.exhibitors} target="_blank" rel="noreferrer">Falar com o Juruna <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href={proposalPdf} target="_blank" rel="noreferrer">Abrir proposta completa <span aria-hidden="true">↗</span></a></div></div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-top"><a class="brand" href="/"><img src="/assets/logo.svg" alt="Family Game Festival" /></a><p>Games, cultura geek e impacto local.<br />Bauru · 19—20 setembro 2026</p><a class="button button-yellow button-small" href="/">Voltar ao site <span aria-hidden="true">↩</span></a></div>
    <div class="container footer-bottom"><span>© 2026 Family Game Festival</span><a href={event.instagramUrl} target="_blank" rel="noreferrer">{event.instagram}</a><span>Parte da arrecadação será revertida para a SORRI Bauru.</span><span class="footer-credit">Desenvolvido pela <a href="https://www.instagram.com/usealterstate/" target="_blank" rel="noreferrer">ALTERSTATE</a></span></div>
  </footer>

  <script>
    const header = document.querySelector('.site-header');
    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelectorAll('.main-nav a');
    menuToggle?.addEventListener('click', () => {
      const open = header?.classList.toggle('menu-open') ?? false;
      menuToggle.setAttribute('aria-expanded', String(open));
    });
    navLinks.forEach((link) => link.addEventListener('click', () => {
      header?.classList.remove('menu-open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }));
  </script>
</BaseLayout>
