---
import fs from 'node:fs';
import path from 'node:path';
import { partners } from '../data/event';

interface Props {
  carousel?: boolean;
}

const { carousel = false } = Astro.props;

const logoDirectory = path.join(process.cwd(), 'public', 'assets', 'logos', 'parceiros');
const logoCandidates: Record<string, string[]> = {
  'Family Games': ['Family Games Festival.svg', 'family-games.svg', 'family-games.png', 'family-games-logo.svg'],
  'Edge 3D Studio': ['Edge 3D Studio.webp', 'edge-3d-studio.svg', 'edge-3d-studio.png', 'Edge 3D Studio.svg', 'Edge 3D Studio.png'],
  Alterstate: ['ALTERSTATE.png', 'alterstate.svg', 'alterstate.png'],
  'SORRI Bauru': ['Sorri Bauru.png', 'sorri-bauru.svg', 'sorri-bauru.png']
};

const getLogo = (name: string) => {
  const filename = logoCandidates[name]?.find((candidate) => fs.existsSync(path.join(logoDirectory, candidate)));
  if (filename) return `/assets/logos/parceiros/${filename.split('/').map(encodeURIComponent).join('/')}`;
  return name === 'Family Games' ? '/assets/logo.svg' : '';
};

const realizationPartner = partners.find((partner) => partner.level === 'Realização');
const supportPartners = partners.filter((partner) => partner.level === 'Apoio');
const merchantPartners = partners.filter((partner) => partner.merchant);
const hierarchyTiers = [
  { key: 'legend', title: 'Legend', partners: partners.filter((partner) => partner.level === 'Legend') },
  { key: 'champion', title: 'Champion', partners: partners.filter((partner) => partner.level === 'Champion') },
  { key: 'power', title: 'Power Up', partners: partners.filter((partner) => partner.level === 'Power-up') },
  { key: 'player', title: 'Player', partners: partners.filter((partner) => partner.level === 'Player') },
  { key: 'support', title: 'Apoio', partners: supportPartners }
] as const;
const activeHierarchyTiers = hierarchyTiers.filter((tier) => tier.partners.length > 0);
const carouselPartners = partners
  .filter((partner) => partner.level !== 'Realização')
  .map((partner) => ({ partner, logo: getLogo(partner.name) }))
  .filter((entry) => entry.logo);
const carouselItems = [...carouselPartners, ...carouselPartners];
const displayLevel = (level: string) => level === 'Power-up' ? 'Power Up' : level;
---

<div class="sponsor-hierarchy">
  {realizationPartner && (
    <article class="realization-feature">
      <div class="realization-feature-copy"><p class="eyebrow eyebrow-yellow">Realização</p><h3>{realizationPartner.name}</h3><span class="realization-pill">REALIZAÇÃO</span></div>
      <span class="realization-logo-frame"><img src={getLogo(realizationPartner.name)} alt={`Logo ${realizationPartner.name}`} /></span>
    </article>
  )}

  {carousel ? (
    <section class="sponsor-carousel-band" aria-label="Patrocinadores e apoiadores confirmados">
      <div class="sponsor-carousel-viewport">
        <div class="sponsor-carousel-track">
          {carouselItems.map(({ partner, logo }, index) => {
            const duplicate = index >= carouselPartners.length;
            return (
              <a class="sponsor-carousel-item" href={partner.href || undefined} target={partner.href ? '_blank' : undefined} rel={partner.href ? 'noreferrer' : undefined} aria-label={`${partner.name} · ${displayLevel(partner.level)}`} title={`${partner.name} · ${displayLevel(partner.level)}`} aria-hidden={duplicate ? 'true' : undefined} tabindex={duplicate ? -1 : undefined}>
                <img src={logo} alt="" />
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ) : (
    <div class="hierarchy-pyramid">
      {activeHierarchyTiers.map((tier) => (
        <article class={`hierarchy-tier hierarchy-tier-${tier.key}`}>
          <div class="hierarchy-logo-grid">
            {tier.partners.map((partner) => (
              <a class="hierarchy-logo-card" href={partner.href || undefined} target={partner.href ? '_blank' : undefined} rel={partner.href ? 'noreferrer' : undefined} aria-label={`Ver ${partner.name}`}>
                <span class="hierarchy-logo-frame">
                  {getLogo(partner.name) ? <img src={getLogo(partner.name)} alt={`Logo ${partner.name}`} /> : <span class="hierarchy-logo-fallback" aria-hidden="true">{partner.name.slice(0, 1)}</span>}
                </span>
                <span class="hierarchy-logo-caption"><strong>{partner.name}</strong><small class="hierarchy-partner-pill">{tier.title}</small></span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  )}

  <slot name="after-hierarchy" />

  <section class="merchant-panel" aria-labelledby="merchant-panel-title">
    <div class="merchant-panel-copy"><p class="eyebrow eyebrow-cyan">Lojistas / expositores</p><h3 id="merchant-panel-title">Quem você encontra na arena.</h3><p>As logos dos lojistas ficam aqui, separadas da hierarquia de patrocínio. A lista cresce conforme novas presenças forem confirmadas.</p></div>
    <div class="merchant-logo-grid">
      {merchantPartners.length > 0 ? merchantPartners.map((partner) => (
        <a class="merchant-logo-card" href={partner.href || undefined} target={partner.href ? '_blank' : undefined} rel={partner.href ? 'noreferrer' : undefined} aria-label={`Ver o lojista ${partner.name}`} title={partner.name}>
          <span class="merchant-logo-frame">{getLogo(partner.name) ? <img src={getLogo(partner.name)} alt={`Logo ${partner.name}`} /> : <span class="hierarchy-logo-fallback" aria-hidden="true">{partner.name.slice(0, 1)}</span>}</span>
        </a>
      )) : <p class="merchant-empty">As logos dos lojistas confirmados aparecerão aqui.</p>}
    </div>
  </section>
</div>
