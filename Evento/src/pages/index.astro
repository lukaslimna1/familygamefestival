        <div class="location-card"><div class="location-icon"><img src="/assets/svg/cursor.svg" alt="" aria-hidden="true" /></div><p class="card-eyebrow">Onde acontece</p><h3>{event.venue}</h3><p>{event.address}</p><div class="location-map"><iframe title="Mapa da SORRI Bauru · Avenida Nações Unidas, 5340" src="https://www.google.com/maps?q=SORRI%20Bauru%2C%20Avenida%20Na%C3%A7%C3%B5es%20Unidas%205340%2C%20Bauru%2C%20S%C3%A3o%20Paulo%2C%20Brasil&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=SORRI+Bauru%2C+Avenida+Na%C3%A7%C3%B5es+Unidas+5340%2C+Bauru%2C+S%C3%A3o+Paulo%2C+Brasil" target="_blank" rel="noreferrer">Abrir no mapa <span aria-hidden="true">↗</span></a><div class="location-tags"><span>19/09 · sábado</span><span>20/09 · domingo</span><span>{event.hours}</span></div></div>
      </div>
