---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SnapHeader from '../../components/SnapHeader.astro';
import { snapConfig } from '../../data/snap';
import { snapPwa } from '../../config/snap';
import '../../styles/snap-v2.css';

const snapConfigJson = JSON.stringify(snapConfig);
---

<BaseLayout
  title="Criar sua foto | FGF Snap"
  description={snapPwa.description}
  manifest="/snap/manifest.webmanifest"
  bodyClass="snap-page"
>
  <main class="snap-v2-shell">
    <SnapHeader back />
    <div class="snap-v2-page">
      <section class="snap-v2-page-heading" aria-labelledby="snap-foto-title">
        <h1 id="snap-foto-title">CRIE SUA <em>FOTO.</em></h1>
        <p>Tire uma foto ou escolha uma da galeria para começar.</p>
      </section>

      <section class="snap-v2-capture-card snap-v2-panel" data-snap-capture-screen aria-label="Escolha uma foto">
        <div class="snap-v2-source-row">
          <button class="snap-v2-button snap-v2-button-primary" type="button" data-snap-open-camera>TIRAR FOTO <span aria-hidden="true">↗</span></button>
          <button class="snap-v2-button snap-v2-button-outline" type="button" data-snap-open-gallery>ESCOLHER DA GALERIA</button>
        </div>
      </section>

      <p class="snap-v2-status snap-global-status" data-snap-status aria-live="polite"></p>

      <section class="snap-editor-screen" data-snap-editor-screen hidden aria-label="Editor de foto">
        <div class="snap-editor-shell" data-snap-editor-shell data-sheet-state="closed">
          <header class="snap-editor-topbar">
            <button class="snap-editor-back" type="button" data-snap-editor-back aria-label="Voltar para escolher outra foto"><span class="snap-back-arrow" aria-hidden="true">←</span></button>

            <div class="snap-editor-format-control">
              <button class="snap-editor-format-toggle" type="button" data-snap-format-toggle aria-expanded="false" aria-controls="snap-format-menu">
                <span data-snap-format-label>9:16</span><span class="snap-format-chevron" aria-hidden="true">⌄</span>
              </button>
              <div class="snap-editor-format-menu" id="snap-format-menu" data-snap-format-menu hidden>
                {snapConfig.formats.map((format) => (
                  <button type="button" data-snap-format-id={format.id} aria-pressed={format.id === 'story'}>{format.label} {format.ratio}</button>
                ))}
              </div>
            </div>

            <button class="snap-editor-complete" type="button" data-snap-complete>CONCLUIR</button>
          </header>

          <div class="snap-editor-photo-area" data-snap-photo-area>
            <div class="snap-editor-canvas-wrap" data-snap-canvas-wrap data-snap-format="story">
              <div id="snap-editor-stage" aria-label="Editor de foto interativo"></div>
            </div>

            <div class="snap-editor-trash" data-snap-trash hidden>
              <span aria-hidden="true">🗑</span>
              <small>Solte aqui para excluir</small>
            </div>

            <div class="snap-editor-context" data-snap-context-toolbar hidden>
              <button class="snap-editor-context-trigger" type="button" data-snap-more aria-expanded="false" aria-controls="snap-more-menu" aria-label="Mais ações">•••</button>
              <div class="snap-editor-more-menu" id="snap-more-menu" data-snap-more-menu hidden>
                <button type="button" data-snap-mirror>Refletir</button>
                <button type="button" data-snap-duplicate>Duplicar</button>
                <button type="button" data-snap-bring-front>Trazer para frente</button>
                <button type="button" data-snap-send-back>Enviar para trás</button>
                <button type="button" data-snap-delete class="snap-menu-delete">Excluir</button>
              </div>
            </div>

            <nav class="snap-editor-sidebar" aria-label="Ferramentas do editor" data-snap-editor-sidebar>
              <button class="snap-editor-sidebar-btn" type="button" data-snap-category="frame" aria-pressed="false" aria-label="Escolher moldura">
                <span class="snap-sidebar-icon" aria-hidden="true">🖼️</span>
                <span class="snap-sidebar-label">Moldura</span>
              </button>
              <button class="snap-editor-sidebar-btn" type="button" data-snap-category="pose" aria-pressed="false" aria-label="Escolher mascote">
                <span class="snap-sidebar-icon" aria-hidden="true">🎮</span>
                <span class="snap-sidebar-label">Mascote</span>
              </button>
              <button class="snap-editor-sidebar-btn" type="button" data-snap-category="sticker" aria-pressed="false" aria-label="Escolher figurinhas">
                <span class="snap-sidebar-icon" aria-hidden="true">✨</span>
                <span class="snap-sidebar-label">Stickers</span>
              </button>
            </nav>
          </div>

          <div class="snap-editor-sheet-backdrop" data-snap-sheet-backdrop hidden aria-hidden="true"></div>

          <aside class="snap-editor-sheet" data-snap-sheet data-sheet-state="closed" aria-label="Ferramentas do editor">
            <button class="snap-editor-sheet-handle" type="button" data-snap-sheet-handle aria-label="Abrir ferramentas" aria-expanded="false"><span aria-hidden="true"></span></button>

            <div class="snap-editor-sheet-content" data-snap-sheet-content hidden>
              <div class="snap-editor-sheet-heading">
                <h2 data-snap-sheet-title>MOLDURA</h2>
                <button type="button" data-snap-sheet-close aria-label="Fechar ferramentas">×</button>
              </div>

              <div class="snap-editor-category-panel" data-snap-category-panel="frame" hidden>
                <p class="snap-editor-frame-notice" data-snap-frame-notice hidden></p>
                <div class="snap-editor-asset-row">
                  <button class="snap-v2-frame-chip" type="button" data-snap-frame-id="none" data-snap-frame-format="all" aria-pressed="false"><span>Sem moldura</span></button>
                  {snapConfig.storyFrames.map((frame, index) => (
                    <button class="snap-v2-frame-chip" type="button" data-snap-frame-id={frame.id} data-snap-frame-format="story" data-snap-frame-pair={frame.pairKey} aria-pressed={index === 0}>
                      <img src={frame.frame} alt="" loading="lazy" /><span>{frame.label}</span>
                    </button>
                  ))}
                  {snapConfig.postFrames.map((frame) => (
                    <button class="snap-v2-frame-chip" type="button" data-snap-frame-id={frame.id} data-snap-frame-format="post" data-snap-frame-pair={frame.pairKey} aria-pressed="false" hidden>
                      <img src={frame.frame} alt="" loading="lazy" /><span>{frame.label}</span>
                    </button>
                  ))}
                </div>
              </div>

              <div class="snap-editor-category-panel" data-snap-category-panel="pose" hidden>
                <div class="snap-editor-asset-row">
                  {snapConfig.poses.map((pose) => (
                    <button class="snap-v2-pose-chip" type="button" data-snap-pose-id={pose.id} aria-pressed="false">
                      <img src={pose.asset} alt="" loading="lazy" /><span>{pose.label}</span>
                    </button>
                  ))}
                </div>
              </div>

              <div class="snap-editor-category-panel" data-snap-category-panel="sticker" hidden>
                <div class="snap-editor-asset-row">
                  {snapConfig.stickers.map((sticker) => (
                    <button class="snap-v2-sticker-chip" type="button" data-snap-sticker-id={sticker.id} aria-pressed="false">
                      <img src={sticker.asset} alt="" loading="lazy" /><span>{sticker.label}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="snap-v2-result-panel snap-v2-panel" data-snap-result-screen hidden aria-label="Seu Snap está pronto.">
        <header class="snap-v2-result-header">
          <p class="snap-v2-eyebrow">SEU SNAP ESTÁ PRONTO.</p>
        </header>
        <div class="snap-v2-result-image-wrap">
          <img data-snap-result alt="Foto composta com elementos do FGF Snap" />
        </div>

        <div class="snap-v2-tags-card" data-snap-tags-card>
          <div class="snap-v2-tags-content">
            <p class="snap-v2-tags-prompt">Vai postar? Marque o evento.</p>
            <div class="snap-v2-tags-badges">
              <span class="snap-v2-tag-badge">@familygamex</span>
              <span class="snap-v2-tag-badge">#FamilyGameFestival2026</span>
            </div>
            <p class="snap-v2-tags-alterstate" data-snap-alterstate-notice hidden>
              Você usou um elemento Alterstate. Marque também <strong>@usealterstate</strong>.
            </p>
          </div>
          <button class="snap-v2-tags-copy-btn" type="button" data-snap-copy-tags aria-label="Copiar marcações para a área de transferência">
            <span data-snap-copy-label>COPIAR MARCAÇÕES</span>
          </button>
        </div>

        <div class="snap-v2-result-actions">
          <button class="snap-v2-button snap-v2-button-primary" type="button" data-snap-share>COMPARTILHAR <span aria-hidden="true">↗</span></button>
          <button class="snap-v2-button snap-v2-button-outline" type="button" data-snap-download>SALVAR</button>
          <button class="snap-v2-button snap-v2-button-outline" type="button" data-snap-edit-again>EDITAR</button>
        </div>
      </section>

      <input class="snap-v2-hidden" type="file" accept="image/*" capture="environment" data-snap-camera-input />
      <input class="snap-v2-hidden" type="file" accept="image/*" data-snap-gallery-input />
      <script id="snap-config" type="application/json" is:inline set:html={snapConfigJson}></script>
    </div>
  </main>

  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/snap/sw.js', { scope: '/snap/' }).catch(() => {}));
    }
  </script>
  <script src="../../scripts/snap-editor.ts"></script>
</BaseLayout>
